if (NOT FOXMES_DISTRIBUTED_PYTHON)
    message(FATAL_ERROR "FOXMES_DISTRIBUTED_PYTHON must name the build interpreter.")
endif()

set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "" FORCE)
set(foxmes_compiler_launcher
    "${FOXMES_DISTRIBUTED_PYTHON};${CMAKE_CURRENT_LIST_DIR}/distributed-build.py;compiler")
foreach(language C CXX OBJC OBJCXX)
    set(CMAKE_${language}_COMPILER_LAUNCHER "${foxmes_compiler_launcher}" CACHE STRING "" FORCE)
endforeach()

if (MSVC)
    include("${CMAKE_CURRENT_LIST_DIR}/force-include-pch.cmake")
endif()

function(foxmes_wrap_swift_targets directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_property(wrapped TARGET ${target} PROPERTY FOXMES_SWIFT_WRAPPED)
        if (wrapped)
            continue()
        endif()
        get_target_property(sources ${target} SOURCES)
        foreach(source IN LISTS sources)
            if (source MATCHES "\\.swift$")
                set(launcher "\"${FOXMES_DISTRIBUTED_PYTHON}\" \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/distributed-build.py\" native")
                set_property(TARGET ${target} PROPERTY FOXMES_SWIFT_WRAPPED TRUE)
                set_property(TARGET ${target} PROPERTY RULE_LAUNCH_COMPILE "${launcher}")
                set_property(TARGET ${target} PROPERTY RULE_LAUNCH_LINK "${launcher}")
                if (CMAKE_OSX_ARCHITECTURES STREQUAL "arm64" AND CMAKE_OSX_DEPLOYMENT_TARGET)
                    target_compile_options(${target} PRIVATE
                        "$<$<COMPILE_LANGUAGE:Swift>:-target>"
                        "$<$<COMPILE_LANGUAGE:Swift>:arm64-apple-macosx${CMAKE_OSX_DEPLOYMENT_TARGET}>")
                endif()
                break()
            endif()
        endforeach()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        foxmes_wrap_swift_targets("${child}")
    endforeach()
endfunction()

if (APPLE)
    cmake_language(DEFER CALL foxmes_wrap_swift_targets "${CMAKE_CURRENT_SOURCE_DIR}")
endif()
