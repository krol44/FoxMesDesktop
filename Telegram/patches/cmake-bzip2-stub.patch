diff --git a/external/bzip2_stub/bzip2_stub.c b/external/bzip2_stub/bzip2_stub.c
new file mode 100644
index 0000000..5ade5f6
--- /dev/null
+++ b/external/bzip2_stub/bzip2_stub.c
@@ -0,0 +1,34 @@
+typedef struct {
+    char *next_in;
+    unsigned int avail_in;
+    unsigned int total_in_lo32;
+    unsigned int total_in_hi32;
+    char *next_out;
+    unsigned int avail_out;
+    unsigned int total_out_lo32;
+    unsigned int total_out_hi32;
+    void *state;
+    void *(*bzalloc)(void *, int, int);
+    void (*bzfree)(void *, void *);
+    void *opaque;
+} bz_stream;
+
+enum {
+    BZ_OK = 0,
+    BZ_PARAM_ERROR = -2,
+    BZ_STREAM_END = 4,
+};
+
+int BZ2_bzDecompressInit(bz_stream *strm, int verbosity, int small) {
+    (void)verbosity;
+    (void)small;
+    return strm ? BZ_OK : BZ_PARAM_ERROR;
+}
+
+int BZ2_bzDecompress(bz_stream *strm) {
+    return strm ? BZ_STREAM_END : BZ_PARAM_ERROR;
+}
+
+int BZ2_bzDecompressEnd(bz_stream *strm) {
+    return strm ? BZ_OK : BZ_PARAM_ERROR;
+}
