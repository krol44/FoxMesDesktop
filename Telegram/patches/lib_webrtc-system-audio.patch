+#pragma once
+
+#include "webrtc/webrtc_system_audio_capture.h"
+
+namespace Webrtc::details {
+
+// Uses the same WASAPI loopback recorder (including far-end suppression)
+// as group screen sharing, without creating a second microphone device.
+class SystemAudioCaptureWin final : public SystemAudioCapture {
+public:
+    explicit SystemAudioCaptureWin(SystemAudioSamplesCallback callback);
+    ~SystemAudioCaptureWin() override;
+    void start() override;
+    void stop() override;
+private:
+    struct State;
+    std::unique_ptr<State> _state;
+};
+
+} // namespace Webrtc::details
