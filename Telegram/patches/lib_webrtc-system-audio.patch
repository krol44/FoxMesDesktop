+#include "webrtc/platform/win/webrtc_system_audio_capture_win.h"
+#include "webrtc/platform/win/webrtc_loopback_adm_win.h"
+
+#include <api/make_ref_counted.h>
+#include <api/task_queue/default_task_queue_factory.h>
+#include <modules/audio_device/include/audio_device_defines.h>
+#include <rtc_base/logging.h>
+
+#include <cstring>
+
+namespace Webrtc::details {
+
+struct SystemAudioCaptureWin::State : webrtc::AudioTransport {
+    explicit State(SystemAudioSamplesCallback callback)
+    : callback(std::move(callback))
+    , queues(webrtc::CreateDefaultTaskQueueFactory())
+    , device(rtc::make_ref_counted<AudioDeviceLoopbackWin>(queues.get())) {
+    }
+
+    int32_t RecordedDataIsAvailable(const void *samples, size_t count,
+            size_t bytes, size_t channels, uint32_t rate, uint32_t delay,
+            int32_t drift, uint32_t level, bool key, uint32_t &newLevel) override {
+        newLevel = level;
+        if (rate != 48000 || channels != 2 || bytes != sizeof(int16_t) * channels) return -1;
+        auto data = std::vector<uint8_t>(count * channels * sizeof(int16_t));
+        memcpy(data.data(), samples, data.size());
+        callback(std::move(data));
+        return 0;
+    }
+    int32_t NeedMorePlayData(size_t count, size_t bytes, size_t channels,
+            uint32_t rate, void *samples, size_t &out,
+            int64_t *elapsed, int64_t *ntp) override {
+        memset(samples, 0, count * bytes);
+        out = count;
+        if (elapsed) *elapsed = -1;
+        if (ntp) *ntp = -1;
+        return 0;
+    }
+    void PullRenderData(int bits, int rate, size_t channels, size_t count,
+            void *samples, int64_t *elapsed, int64_t *ntp) override {
+        memset(samples, 0, count * channels * bits / 8);
+        if (elapsed) *elapsed = -1;
+        if (ntp) *ntp = -1;
+    }
+    SystemAudioSamplesCallback callback;
+    std::unique_ptr<webrtc::TaskQueueFactory> queues;
+    rtc::scoped_refptr<AudioDeviceLoopbackWin> device;
+    bool started = false;
+};
+
+SystemAudioCaptureWin::SystemAudioCaptureWin(SystemAudioSamplesCallback callback)
+: _state(std::make_unique<State>(std::move(callback))) {
+}
+SystemAudioCaptureWin::~SystemAudioCaptureWin() { stop(); }
+void SystemAudioCaptureWin::start() {
+    if (_state->started) return;
+    auto &device = _state->device;
+    if (device->Init() != 0 || device->RegisterAudioCallback(_state.get()) != 0
+        || device->InitRecording() != 0 || device->StartRecording() != 0) {
+        RTC_LOG(LS_ERROR) << "FoxMes: WASAPI system audio could not start";
+        device->Terminate();
+        device->RegisterAudioCallback(nullptr);
+        return;
+    }
+    _state->started = true;
+}
+void SystemAudioCaptureWin::stop() {
+    _state->device->StopRecording();
+    _state->device->RegisterAudioCallback(nullptr);
+    _state->device->Terminate();
+    _state->started = false;
+}
+
+} // namespace Webrtc::details
