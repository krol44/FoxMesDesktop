+namespace tgcalls {
+rtc::scoped_refptr<webrtc::VideoFrameBuffer> MacScreenFrame(CMSampleBufferRef sample) {
+    if (!sample || !CMSampleBufferIsValid(sample)) return nullptr;
+    const auto pixel = CMSampleBufferGetImageBuffer(sample);
+    if (!pixel) return nullptr;
+    const auto width = int(CVPixelBufferGetWidth(pixel));
+    const auto height = int(CVPixelBufferGetHeight(pixel));
+    if (width < 2 || height < 2) return nullptr;
+    int x = 0, y = 0, visibleWidth = width, visibleHeight = height;
+    // Resizing a window may temporarily leave its content in a larger surface.
+    // Carry the visible region as native crop metadata instead of sending padding.
+    if (@available(macOS 12.3, *)) {
+        NSArray *attachments = (__bridge NSArray *)CMSampleBufferGetSampleAttachmentsArray(sample, false);
+        NSDictionary *metadata = attachments.firstObject;
+        auto rectValue = (__bridge CFTypeRef)metadata[SCStreamFrameInfoContentRect];
+        CGRect rect;
+        const auto scale = [metadata[SCStreamFrameInfoScaleFactor] doubleValue];
+        if (rectValue && CFGetTypeID(rectValue) == CFDictionaryGetTypeID() && scale > 0.
+            && CGRectMakeWithDictionaryRepresentation((CFDictionaryRef)rectValue, &rect)) {
+            x = std::clamp(int(std::lround(rect.origin.x * scale)), 0, width - 2) & ~1;
+            y = std::clamp(int(std::lround(rect.origin.y * scale)), 0, height - 2) & ~1;
+            visibleWidth = std::min(width - x, (int(std::lround(rect.size.width * scale)) + 1) & ~1);
+            visibleHeight = std::min(height - y, (int(std::lround(rect.size.height * scale)) + 1) & ~1);
+            if (visibleWidth <= 0 || visibleHeight <= 0) return nullptr;
+        }
+    }
+    return rtc::make_ref_counted<webrtc::ObjCFrameBuffer>(
+        [[FoxMesScreenPixelBuffer alloc] initWithLease:std::make_shared<SurfaceLease>(sample)
+            width:visibleWidth height:visibleHeight cropWidth:visibleWidth cropHeight:visibleHeight cropX:x cropY:y]);
+}
+DesktopSize MacScreenCaptureSize(DesktopSize source, DesktopSize limit) {
+    if (source.width <= 0 || source.height <= 0) return {};
+    double scale = 1.;
+    if (limit.width > 0 && limit.height > 0) {
+        scale = std::min({1., double(limit.width) / source.width, double(limit.height) / source.height});
+    }
+    // NV12 requires even dimensions. Preserve odd source pixels by rounding
+    // up; constrained modes round down to keep their advertised size limit.
+    const auto even = [scale](int dimension) {
+        return std::max(2, (scale == 1. ? (dimension + 1) / 2 : int(dimension * scale) / 2) * 2);
+    };
+    return {even(source.width), even(source.height)};
+}
+}
