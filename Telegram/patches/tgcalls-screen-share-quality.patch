+    SCStream *_stream;
+    SCStreamConfiguration *_configuration;
+    dispatch_source_t _timer;
+    rtc::scoped_refptr<webrtc::VideoFrameBuffer> _latest;
+    bool _running, _paused, _updatingConfiguration;
+    uint64_t _generation, _serial, _deliveredSerial;
+    int64_t _windowStart, _lastDelivery, _deadline;
+    int64_t _period;
+    uint64_t _captured, _changed, _delivered;
