+class HardwareLeafFactory final : public webrtc::VideoEncoderFactory {
+public:
+    std::vector<webrtc::SdpVideoFormat> GetSupportedFormats() const override {
+        auto formats = _software.GetSupportedFormats();
+        formats.erase(std::remove_if(formats.begin(), formats.end(), [](const auto &format) {
+            return format.name == cricket::kVp8CodecName;
+        }), formats.end());
+        return formats;
+    }
+    CodecSupport QueryCodecSupport(const webrtc::SdpVideoFormat &format,
+            absl::optional<std::string> scalability) const override {
+        if (format.name == cricket::kVp8CodecName) return {};
+        // EncoderInfo reports hardware only after successful initialization.
+        // Registration of an FFmpeg encoder alone is not proof of a GPU.
+        return _software.QueryCodecSupport(format, scalability);
+    }
+    std::unique_ptr<webrtc::VideoEncoder> CreateVideoEncoder(const webrtc::SdpVideoFormat &format) override {
+        if (format.name == cricket::kVp8CodecName) return nullptr;
+        auto encoder = _software.CreateVideoEncoder(format);
+        if (!encoder || format.name != cricket::kH264CodecName) return encoder;
+        const auto mode = format.parameters.find("packetization-mode");
+        if (mode != format.parameters.end() && mode->second == "1"
+                && !HardwareBackends().empty()) {
+            encoder = webrtc::CreateVideoEncoderSoftwareFallbackWrapper(
+                std::move(encoder), std::make_unique<HardwareH264Encoder>(format));
+        }
+        return std::make_unique<SingleStreamEncoder>(std::move(encoder));
+    }
+private:
+    webrtc::InternalEncoderFactory _software;
+};
+
+class DesktopEncoderFactory final : public webrtc::VideoEncoderFactory {
+public:
+    std::vector<webrtc::SdpVideoFormat> GetSupportedFormats() const override { return _leaf.GetSupportedFormats(); }
+    CodecSupport QueryCodecSupport(const webrtc::SdpVideoFormat &format,
+            absl::optional<std::string> scalability) const override {
+        return _leaf.QueryCodecSupport(format, scalability);
+    }
+    std::unique_ptr<webrtc::VideoEncoder> CreateVideoEncoder(const webrtc::SdpVideoFormat &format) override {
+        if (!format.IsCodecInList(GetSupportedFormats())) return nullptr;
+        return std::make_unique<webrtc::SimulcastEncoderAdapter>(&_leaf, format);
+    }
+private:
+    HardwareLeafFactory _leaf;
+};
