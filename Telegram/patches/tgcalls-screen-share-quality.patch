+// Worker/media queues publish only the current screen ceiling. The controller
+// owns its policy on its own queue; UI diagnostics receive atomic snapshots.
+struct ScreenBandwidthProbeState {
+    std::atomic<int> screenLimit{0}, attempts{0}, lastBitrate{0};
+    std::atomic<ScreenBandwidthProbeStatus> status{ScreenBandwidthProbeStatus::Inactive};
+    void fillStats(ScreenSharingStats &stats) const {
+        stats.bandwidthProbeAttempts = attempts.load();
+        stats.bandwidthProbeBitrate = lastBitrate.load();
+        stats.bandwidthProbeState = ScreenBandwidthProbeStatusText(status.load());
+    }
+};
+
+class ScreenBandwidthProbeController final : public webrtc::NetworkControllerInterface {
+public:
+    ScreenBandwidthProbeController(std::unique_ptr<webrtc::NetworkControllerInterface> delegate,
+            std::shared_ptr<ScreenBandwidthProbeState> state, const webrtc::NetworkControllerConfig &config)
+    : _delegate(std::move(delegate)), _state(std::move(state)) {
+        setLimit(config.constraints);
+    }
