+// WebRTC's native crop operation must preserve the surface lease as well as
+// the CVPixelBuffer. Retaining only a CVPixelBuffer does not mark it in use.
+@interface FoxMesScreenPixelBuffer : RTCCVPixelBuffer
+- (instancetype)initWithLease:(std::shared_ptr<SurfaceLease>)lease
+                       width:(int)width height:(int)height
+                   cropWidth:(int)cropWidth cropHeight:(int)cropHeight
+                       cropX:(int)cropX cropY:(int)cropY;
+- (id<RTCVideoFrameBuffer>)cropAndScaleWith:(int)x offsetY:(int)y
+                               cropWidth:(int)width cropHeight:(int)height
+                              scaleWidth:(int)scaledWidth scaleHeight:(int)scaledHeight;
+@end
+@implementation FoxMesScreenPixelBuffer {
+    std::shared_ptr<SurfaceLease> _lease;
+}
+- (instancetype)initWithLease:(std::shared_ptr<SurfaceLease>)lease
+                       width:(int)width height:(int)height
+                   cropWidth:(int)cropWidth cropHeight:(int)cropHeight
+                       cropX:(int)cropX cropY:(int)cropY {
+    self = [super initWithPixelBuffer:CMSampleBufferGetImageBuffer(lease->sample)
+                        adaptedWidth:width adaptedHeight:height
+                           cropWidth:cropWidth cropHeight:cropHeight cropX:cropX cropY:cropY];
+    if (self) _lease = std::move(lease);
+    return self;
+}
+- (id<RTCVideoFrameBuffer>)cropAndScaleWith:(int)x offsetY:(int)y
+                               cropWidth:(int)width cropHeight:(int)height
+                              scaleWidth:(int)scaledWidth scaleHeight:(int)scaledHeight {
+    return [[FoxMesScreenPixelBuffer alloc] initWithLease:_lease
+        width:scaledWidth height:scaledHeight
+        cropWidth:width * self.cropWidth / self.width
+        cropHeight:height * self.cropHeight / self.height
+        cropX:self.cropX + x * self.cropWidth / self.width
+        cropY:self.cropY + y * self.cropHeight / self.height];
+}
+@end
