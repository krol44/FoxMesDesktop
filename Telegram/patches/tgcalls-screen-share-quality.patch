+    webrtc::NetworkControlUpdate OnProcessInterval(webrtc::ProcessInterval msg) override {
+        auto result = observe(_delegate->OnProcessInterval(msg));
+        const auto nowMs = msg.at_time.ms();
+        const auto queueMs = msg.pacer_queue && _bandwidth > 0
+            ? msg.pacer_queue->bytes() * 8000 / _bandwidth : -1;
+        const auto rate = _policy.update(nowMs, _state->screenLimit.load(), _bandwidth,
+            _rttMs, std::max(_loss, _feedbackLoss), queueMs,
+            _lastFeedbackMs < 0 ? -1 : nowMs - _lastFeedbackMs, _networkAvailable,
+            std::min(_maxRate, _remoteRate), _lastNativeProbeMs != _handledNativeProbeMs);
+        _handledNativeProbeMs = _lastNativeProbeMs;
+        if (rate > 0) {
+            webrtc::ProbeClusterConfig probe;
+            probe.at_time = msg.at_time;
+            probe.target_data_rate = webrtc::DataRate::BitsPerSec(rate);
+            probe.target_duration = webrtc::TimeDelta::Millis(15);
+            probe.target_probe_count = 5;
+            // Native GoogCC IDs start at 1. Keep recovery clusters in a separate
+            // range so their packet feedback cannot merge with native clusters.
+            probe.id = _nextProbeId++;
+            result.probe_cluster_configs.push_back(probe);
+            ++_state->attempts;
+            _state->lastBitrate = rate;
+            RTC_LOG(LS_INFO) << "FoxMes: screen bandwidth probe " << rate << " bps; estimate " << _bandwidth;
+        }
+        _state->status = _policy.status();
+        return result;
+    }
+    webrtc::NetworkControlUpdate OnNetworkAvailability(webrtc::NetworkAvailability msg) override {
+        _networkAvailable = msg.network_available;
+        return observe(_delegate->OnNetworkAvailability(msg));
+    }
+    webrtc::NetworkControlUpdate OnNetworkRouteChange(webrtc::NetworkRouteChange msg) override {
+        _policy.reset();
+        _lastFeedbackMs = -1;
+        _lastNativeProbeMs = _handledNativeProbeMs = -1;
+        _remoteRate = std::numeric_limits<int>::max();
+        _feedbackLoss = 0;
+        setLimit(msg.constraints);
+        return observe(_delegate->OnNetworkRouteChange(msg));
+    }
+    webrtc::NetworkControlUpdate OnRemoteBitrateReport(webrtc::RemoteBitrateReport msg) override {
+        _remoteRate = finiteRate(msg.bandwidth);
+        return observe(_delegate->OnRemoteBitrateReport(msg));
+    }
+    webrtc::NetworkControlUpdate OnRoundTripTimeUpdate(webrtc::RoundTripTimeUpdate msg) override {
+        if (msg.round_trip_time.IsFinite()) _rttMs = msg.round_trip_time.ms();
+        return observe(_delegate->OnRoundTripTimeUpdate(msg));
+    }
+    webrtc::NetworkControlUpdate OnSentPacket(webrtc::SentPacket msg) override {
+        return observe(_delegate->OnSentPacket(msg));
+    }
+    webrtc::NetworkControlUpdate OnReceivedPacket(webrtc::ReceivedPacket msg) override {
+        return observe(_delegate->OnReceivedPacket(msg));
+    }
+    webrtc::NetworkControlUpdate OnStreamsConfig(webrtc::StreamsConfig msg) override {
+        return observe(_delegate->OnStreamsConfig(msg));
+    }
+    webrtc::NetworkControlUpdate OnTargetRateConstraints(webrtc::TargetRateConstraints msg) override {
+        setLimit(msg);
+        return observe(_delegate->OnTargetRateConstraints(msg));
+    }
+    webrtc::NetworkControlUpdate OnTransportLossReport(webrtc::TransportLossReport msg) override {
+        return observe(_delegate->OnTransportLossReport(msg));
+    }
+    webrtc::NetworkControlUpdate OnTransportPacketsFeedback(webrtc::TransportPacketsFeedback msg) override {
+        const auto packets = msg.PacketsWithFeedback();
+        if (!packets.empty()) {
+            _lastFeedbackMs = msg.feedback_time.ms();
+            const auto lost = std::count_if(packets.begin(), packets.end(),
+                [](const webrtc::PacketResult &packet) { return !packet.IsReceived(); });
+            _feedbackLoss = double(lost) / packets.size();
+        }
+        return observe(_delegate->OnTransportPacketsFeedback(msg));
+    }
+    webrtc::NetworkControlUpdate OnNetworkStateEstimate(webrtc::NetworkStateEstimate msg) override {
+        return observe(_delegate->OnNetworkStateEstimate(msg));
+    }
+
+private:
+    static int finiteRate(webrtc::DataRate rate) {
+        return rate.IsFinite() ? int(std::clamp<int64_t>(rate.bps(), 0, std::numeric_limits<int>::max()))
+            : std::numeric_limits<int>::max();
+    }
+    void setLimit(const webrtc::TargetRateConstraints &constraints) {
+        _maxRate = constraints.max_data_rate ? finiteRate(*constraints.max_data_rate) : std::numeric_limits<int>::max();
+    }
+    webrtc::NetworkControlUpdate observe(webrtc::NetworkControlUpdate result) {
+        // Native clusters can arrive from packet feedback or constraint updates,
+        // not just OnProcessInterval. Avoid overlapping their probe window.
+        for (const auto &probe : result.probe_cluster_configs) {
+            _lastNativeProbeMs = probe.at_time.ms();
+        }
+        if (result.target_rate) {
+            _bandwidth = finiteRate(result.target_rate->target_rate);
+            const auto &estimate = result.target_rate->network_estimate;
+            if (estimate.round_trip_time.IsFinite()) _rttMs = estimate.round_trip_time.ms();
+            _loss = estimate.loss_rate_ratio;
+        }
+        return result;
+    }
+    std::unique_ptr<webrtc::NetworkControllerInterface> _delegate;
+    std::shared_ptr<ScreenBandwidthProbeState> _state;
+    ScreenBandwidthProbePolicy _policy;
+    int _bandwidth = 0, _maxRate = std::numeric_limits<int>::max(), _remoteRate = std::numeric_limits<int>::max();
+    int32_t _nextProbeId = 0x40000000;
+    int64_t _rttMs = -1, _lastFeedbackMs = -1;
+    int64_t _lastNativeProbeMs = -1, _handledNativeProbeMs = -1;
+    double _loss = 0, _feedbackLoss = 0;
+    bool _networkAvailable = false;
+};
+
+class ScreenBandwidthProbeFactory final : public webrtc::NetworkControllerFactoryInterface {
+public:
+    explicit ScreenBandwidthProbeFactory(std::shared_ptr<ScreenBandwidthProbeState> state) : _state(std::move(state)) {}
+    std::unique_ptr<webrtc::NetworkControllerInterface> Create(webrtc::NetworkControllerConfig config) override {
+        return std::make_unique<ScreenBandwidthProbeController>(_factory.Create(config), _state, config);
+    }
+    webrtc::TimeDelta GetProcessInterval() const override { return _factory.GetProcessInterval(); }
+private:
+    webrtc::GoogCcNetworkControllerFactory _factory;
+    std::shared_ptr<ScreenBandwidthProbeState> _state;
+};
+} // namespace tgcalls
