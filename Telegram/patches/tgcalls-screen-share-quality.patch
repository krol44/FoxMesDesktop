+#ifndef TGCALLS_DESKTOP_CAPTURE_SCHEDULE_H_
+#define TGCALLS_DESKTOP_CAPTURE_SCHEDULE_H_
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace tgcalls {
+
+// Deadlines stay anchored to a monotonic epoch rather than to the last actual
+// wake-up. Queue lateness and timer rounding therefore do not accumulate.
+class DesktopCaptureSchedule {
+public:
+    explicit DesktopCaptureSchedule(double fps) : _fps(std::max(1.0, fps)) {}
+
+    void reset(int64_t nowUs) {
+        _startedUs = nowUs;
+        _frameIndex = 0;
+    }
+
+    int64_t next(int64_t nowUs) {
+        // Keep at most the latest overdue slot. A slow capture or a long pause
+        // must not create a backlog of captures replayed in a burst.
+        const auto latestSlot = int64_t(std::floor(
+            double(nowUs - _startedUs) * _fps / 1000000.0));
+        _frameIndex = std::max(_frameIndex + 1, latestSlot);
+        return _startedUs + int64_t(std::llround(
+            double(_frameIndex) * 1000000.0 / _fps));
+    }
+
+private:
+    const double _fps;
+    int64_t _startedUs = 0;
+    int64_t _frameIndex = 0;
+};
+
+} // namespace tgcalls
+
+#endif // TGCALLS_DESKTOP_CAPTURE_SCHEDULE_H_
