+                for (SCDisplay *display in content.displays) {
+                    if (display.displayID != self->sourceId) continue;
+                    filter = [[SCContentFilter alloc] initWithDisplay:display excludingWindows:@[]];
+                    size = {int(CGDisplayPixelsWide(display.displayID)), int(CGDisplayPixelsHigh(display.displayID))};
