+#ifndef TGCALLS_SCREEN_SHARING_H
+#define TGCALLS_SCREEN_SHARING_H
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <string>
+
+namespace tgcalls {
+// Encoded screen video only; transport headers, RTX and padding are separate.
+inline constexpr int kScreenSharingMaxBitrate = 15000000;
+inline int ClampScreenSharingBitrate(int64_t bitrate) {
+    return int(std::clamp<int64_t>(bitrate, 0, kScreenSharingMaxBitrate));
+}
+inline int ScreenSharingRecoveryBandwidth(int bandwidth, int videoLimit) {
+    // A healthy stream at its configured ceiling need not regain an old BWE.
+    return std::min(bandwidth, videoLimit);
+}
+inline int64_t ScreenSharingBurstLimitBytes(uint32_t bitrate) {
+    // Retain VT's burst allowance at low rates, bounded by the video ceiling.
+    return std::min<int64_t>(int64_t(bitrate) * 3 / 2, kScreenSharingMaxBitrate) / 8;
+}
+struct ScreenSharingProfile {
+    int width;
+    int height;
+    int fps;
+    int startBitrate;
+    int maxBitrate;
+};
+inline ScreenSharingProfile ScreenSharingProfileForQuality(int quality) {
+    // Zero dimensions preserve source pixels. Limits never upscale a source.
+    constexpr std::array<ScreenSharingProfile, 12> profiles = {{
+        {2560,1440,15,6000000,10000000},
+        {0,0,5,6000000,15000000}, {2560,1440,5,4000000,8000000},
+        {0,0,60,10000000,kScreenSharingMaxBitrate}, {2560,1440,60,8000000,kScreenSharingMaxBitrate}, {1920,1080,60,6000000,12000000},
+        {0,0,30,10000000,kScreenSharingMaxBitrate}, {2560,1440,30,6000000,15000000}, {1920,1080,30,4000000,8000000},
+        {0,0,15,8000000,kScreenSharingMaxBitrate}, {2560,1440,15,6000000,10000000}, {1920,1080,15,4000000,6000000}
+    }};
+    return profiles[std::clamp(quality, 0, 11)];
+}
+inline int ScreenSharingQualityFromDeviceId(const std::string &id) {
+    const auto pos = id.find("@foxmes-quality=");
+    if (pos == std::string::npos) return 0;
+    const auto value = id.substr(pos + 16);
+    for (int i = 0; i != 12; ++i) if (value == std::to_string(i)) return i;
+    return 0;
+}
+inline std::string ScreenSharingSourceId(const std::string &id) {
+    return id.substr(0, id.find("@foxmes-quality="));
+}
+inline std::string ScreenSharingDeviceId(const std::string &id, int quality) {
+    return ScreenSharingSourceId(id) + "@foxmes-quality=" + std::to_string(std::clamp(quality, 0, 11));
+}
+struct ScreenCaptureStats {
+    bool available = false;
+    bool nativeCapture = false;
+    int sourceWidth = 0, sourceHeight = 0;
+    int width = 0, height = 0, requestedFps = 0;
+    double captureFps = 0, changedFps = 0, convertedFps = 0, deliveredFps = 0;
+    double captureMs = 0, scaleMs = 0, convertMs = 0, deliverMs = 0;
+    double loopMs = 0, maxLoopMs = 0, intervalMs = 0, schedulerDelayMs = 0;
+    uint64_t capturedFrames = 0, deliveredFrames = 0;
+    uint64_t captureErrors = 0, unchangedFrames = 0, skippedUnchangedFrames = 0, poolDrops = 0, conversionErrors = 0;
+};
+struct ScreenSharingStats {
+    int width = 0;
+    int height = 0;
+    int fps = 0;
+    int bitrate = 0;
+    int inputFps = 0;
+    double encoderInputFps = 0;
+    std::string configurationError;
+    bool cpuLimited = false;
+    std::string codec;
+    ScreenCaptureStats capture;
+    int availableBitrate = 0, targetBitrate = 0;
+    int rtpBitrate = -1, retransmissionBitrate = -1;
+    int encodeMs = 0, encodeUsagePercent = 0;
+    int64_t rttMs = -1, pacerDelayMs = 0;
+    double lossPercent = 0, averageQp = -1;
+    uint64_t encodedFrames = 0, keyFrames = 0, nacks = 0, plis = 0;
+    std::string encoder, limitation = "none", recovery = "monitoring";
+    int recoveryAttempts = 0;
+    int recoveryBaselineBitrate = 0, recoverySamples = 0, recoveryCooldown = 0;
+    int bandwidthProbeAttempts = 0, bandwidthProbeBitrate = 0;
+    std::string bandwidthProbeState = "inactive";
+    bool powerEfficient = false, powerEfficientKnown = false;
+};
+
+enum class VideoRecoveryAction { None, RefreshFrame, ResetAdaptation };
+
+inline bool ScreenEncoderBitrateUndershoot(int64_t target, int64_t media, bool coarse) {
+    // A quiet image at low QP is normal. Very coarse output using <1/8 of
+    // an allocation >=2 Mbps is evidence of stuck rate control, not a reason
+    // to wait for the transport to regain an earlier peak estimate.
+    return coarse && target >= 2000000 && media > 0 && media * 8 < target;
+}
+
+// Samples arrive once a second. After bandwidth recovers, refresh the picture;
+// also clear adaptation if outgoing resolution or FPS remains restricted.
+class VideoQualityRecovery {
+public:
+    const char *state() const {
+        if (_waitingForEncoder) return _cooldown > 0
+            ? "encoder recovery cooldown" : "waiting for encoder rate control";
+        return _dip ? (_recoveredSamples ? "waiting for stable bandwidth" : "waiting for bandwidth") : "monitoring";
+    }
+    int attempts() const { return _attempts; }
+    int baselineBitrate() const { return _healthyBandwidth; }
+    int recoveredSamples() const { return std::max(_recoveredSamples, _encoderSamples); }
+    int cooldown() const { return _cooldown; }
+    VideoRecoveryAction update(int bandwidth, int pixels, int fps, bool cpuLimited, double sourceFps = 0, double changedFps = -1,
+            const ScreenSharingStats *stats = nullptr) {
+        if (_cooldown > 0) --_cooldown;
+        if (_healthyBandwidth > 0 && bandwidth < _healthyBandwidth * 0.55) _dip = true;
+        const auto allocationHealthy = stats && !cpuLimited
+            && stats->targetBitrate >= 1000000
+            && int64_t(bandwidth) * 10 >= int64_t(stats->targetBitrate) * 9
+            && stats->lossPercent <= 2 && stats->pacerDelayMs <= 80
+            && (stats->rttMs < 0 || stats->rttMs <= 250);
+        const auto coarse = stats && (((stats->codec == "H264" || stats->codec == "H265")
+            && stats->averageQp >= 48) || (stats->codec == "VP9" && stats->averageQp >= 205));
+        _waitingForEncoder = allocationHealthy && pixels > 0 && fps > 0
+            && ScreenEncoderBitrateUndershoot(stats->targetBitrate, stats->bitrate, coarse);
+        if (_waitingForEncoder) {
+            if (!_encoderTarget || int64_t(stats->targetBitrate) * 5 < int64_t(_encoderTarget) * 4
+                || int64_t(stats->targetBitrate) * 5 > int64_t(_encoderTarget) * 6) {
+                _encoderTarget = stats->targetBitrate;
+                _encoderSamples = 0;
+            }
+            // VT H265 has a local 3-second watchdog. Give it time to recover
+            // before escalating to recreation of the whole WebRTC sender.
+            const auto required = stats->codec == "H265" && stats->encoder == "VideoToolbox" ? 8 : 4;
+            _encoderSamples = std::min(_encoderSamples + 1, required);
+            _recoveredSamples = 0;
+            if (_encoderSamples < required || _cooldown > 0) return VideoRecoveryAction::None;
+            _encoderSamples = 0;
+            _cooldown = 30;
+            _healthyBandwidth = bandwidth;
+            _dip = true;
+            ++_attempts;
+            return VideoRecoveryAction::ResetAdaptation;
+        }
+        _encoderSamples = _encoderTarget = 0;
+        if (pixels <= 0 || fps <= 0 || bandwidth <= 0 || cpuLimited) {
+            _recoveredSamples = 0;
+            return VideoRecoveryAction::None;
+        }
+        if (!_dip) {
+            if (_healthyBandwidth > 0 && bandwidth < _healthyBandwidth * 0.55) {
+                _dip = true;
+                _recoveredSamples = 0;
+            } else {
+                _healthyBandwidth = _healthyBandwidth == 0
+                    ? bandwidth
+                    : int((15LL * _healthyBandwidth + bandwidth) / 16);
+                _healthyPixels = std::max(_healthyPixels, pixels);
+                _healthyFps = std::max(_healthyFps, fps);
+            }
+            return VideoRecoveryAction::None;
+        }
+        if (bandwidth < _healthyBandwidth * 0.75 && !allocationHealthy) {
+            _recoveredSamples = 0;
+            return VideoRecoveryAction::None;
+        }
+        if (++_recoveredSamples < (allocationHealthy ? 4 : 8) || _cooldown > 0) return VideoRecoveryAction::None;
+        const auto outputRecovered = pixels >= _healthyPixels * 0.90
+            && (fps >= _healthyFps * 0.75
+                // Quiet or genuinely slow capture is not an encoder limit.
+                // Never use the encoder input estimate as capture evidence.
+                || (sourceFps > 0 && sourceFps < _healthyFps * 0.75
+                    && fps >= sourceFps * 0.75)
+                || (changedFps >= 0 && changedFps < _healthyFps * 0.75
+                    && fps >= changedFps * 0.75));
+        // Keep monitoring a restricted output after a reset. A failed reset
+        // must not silently mark the stream healthy forever.
+        _dip = !outputRecovered;
+        if (outputRecovered) _healthyBandwidth = bandwidth;
+        _recoveredSamples = 0;
+        _cooldown = 30;
+        ++_attempts;
+        return outputRecovered
+            ? VideoRecoveryAction::RefreshFrame
+            : VideoRecoveryAction::ResetAdaptation;
+    }
+private:
+    int _healthyBandwidth = 0;
+    int _healthyPixels = 0;
+    int _healthyFps = 0;
+    int _recoveredSamples = 0;
+    int _cooldown = 0;
+    int _encoderSamples = 0, _encoderTarget = 0;
+    bool _waitingForEncoder = false;
+    int _attempts = 0;
+    bool _dip = false;
+};
+} // namespace tgcalls
+#endif
