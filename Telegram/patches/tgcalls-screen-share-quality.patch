+        ++stats.skippedUnchangedFrames;
+        [self publishStats];
+        return;
+    }
+    _deliveredSerial = _serial;
+    auto frame = webrtc::VideoFrame::Builder().set_video_frame_buffer(_latest)
+        .set_rotation(webrtc::kVideoRotation_0).set_timestamp_us(now).build();
+    // Capture and delivery run on this serial queue. Consumers may retain a
+    // frame, but the immutable surface will remain leased until they release it.
+    auto sink = output;
+    auto preview = secondaryOutput;
+    if (sink) sink->OnFrame(frame);
+    if (preview) preview->OnFrame(frame);
+    const auto delivery = double(rtc::TimeMicros() - now) / 1000.;
+    _deliveryTotal += delivery;
+    stats.maxLoopMs = std::max(stats.maxLoopMs, delivery);
+    _lateTotal += double(lateness) / 1000.;
+    if (_lastDelivery) _intervalTotal += double(now - _lastDelivery) / 1000.;
+    _lastDelivery = now;
+    ++_delivered;
+    ++stats.deliveredFrames;
