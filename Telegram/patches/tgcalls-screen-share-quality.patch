+// VideoToolbox can retain near-maximum QP after a bitrate dip even when its
+// allocation has recovered. A keyframe alone does not reset that rate control.
+class H265BitrateRecovery {
+public:
+    bool update(int64_t now, uint32_t target, uint32_t media, int qp) {
+        if (_healthyTarget && target < _healthyTarget * 0.55) {
+            _dip = true;
+        }
+        if (target && qp >= 0 && qp < 40) {
+            _healthyTarget = std::max(_healthyTarget, target);
+            _dip = false;
+        }
+        const auto stalled = _dip && target >= _healthyTarget * 0.75
+            && qp >= 48 && media > 0 && int64_t(media) * 4 < target;
+        if (!stalled) {
+            _stalledSince = -1;
+            return false;
+        }
+        if (_stalledSince < 0) {
+            _stalledSince = now;
+        }
+        if (now - _stalledSince < 3000 || now < _retryAfter) {
+            return false;
+        }
+        _stalledSince = -1;
+        _retryAfter = now + 30000;
+        return true;
+    }
+
+private:
+    uint32_t _healthyTarget = 0;
+    bool _dip = false;
+    int64_t _stalledSince = -1;
+    int64_t _retryAfter = 0;
+};
+
+} // namespace tgcalls
