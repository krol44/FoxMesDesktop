+#ifndef TGCALLS_DESKTOP_CAPTURE_CONVERSION_H
+#define TGCALLS_DESKTOP_CAPTURE_CONVERSION_H
+
+#include "third_party/libyuv/include/libyuv.h"
+#include <algorithm>
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace tgcalls {
+
+class DesktopCaptureConversion {
+public:
+    DesktopCaptureConversion() = default;
+    DesktopCaptureConversion(const DesktopCaptureConversion &) = delete;
+    DesktopCaptureConversion &operator=(const DesktopCaptureConversion &) = delete;
+
+    ~DesktopCaptureConversion() {
+        {
+            const auto lock = std::lock_guard<std::mutex>(_mutex);
+            _stopping = true;
+        }
+        _start.notify_all();
+        for (auto &worker : _workers) worker.join();
+    }
+
+    int scale(const uint8_t *source, int sourceStride, int sourceWidth, int sourceHeight,
+            uint8_t *destination, int destinationStride, int width, int height) {
+        return run(width, height, [&](int first, int rows) {
+            return libyuv::ARGBScaleClip(source, sourceStride, sourceWidth, sourceHeight,
+                destination, destinationStride, width, height,
+                0, first, width, rows, libyuv::kFilterBilinear);
+        });
+    }
+
+    int convert(const uint8_t *source, int sourceStride, uint8_t *y, int yStride,
+            uint8_t *u, int uStride, uint8_t *v, int vStride, int width, int height) {
+        return run(width, height, [&](int first, int rows) {
+            return libyuv::ARGBToI420(source + first * sourceStride, sourceStride,
+                y + first * yStride, yStride,
+                u + first / 2 * uStride, uStride,
+                v + first / 2 * vStride, vStride, width, rows);
+        });
+    }
+
+private:
+    // Jobs are synchronous on the capture thread; workers borrow buffers only
+    // until run() returns. Clipped scaling keeps the full-frame coordinates,
+    // so interpolation is identical across stripe boundaries. Conversion uses
+    // even row boundaries to keep each I420 chroma sample in one job. Bound the
+    // worker count to leave CPU capacity for encoding, audio and the interface.
+    int run(int width, int height, std::function<int(int, int)> task) {
+        if (height % 2 != 0 || int64_t(width) * height < 1280 * 720) {
+            return task(0, height);
+        }
+        if (!_initialized) {
+            _initialized = true;
+            const auto count = std::clamp(std::thread::hardware_concurrency() / 2, 1u, 4u);
+            _results.resize(count);
+            for (auto index = 1u; index < count; ++index) {
+                _workers.emplace_back([this, index] { work(index); });
+            }
+        }
+        if (_workers.empty()) return task(0, height);
+        {
+            const auto lock = std::lock_guard<std::mutex>(_mutex);
+            _task = std::move(task);
+            _height = height;
+            _remaining = _workers.size();
+            ++_generation;
+        }
+        _start.notify_all();
+        execute(0);
+        {
+            auto lock = std::unique_lock<std::mutex>(_mutex);
+            _done.wait(lock, [&] { return _remaining == 0; });
+            _task = {};
+        }
+        for (const auto result : _results) {
+            if (result != 0) return result;
+        }
+        return 0;
+    }
+
+    void execute(size_t index) {
+        const auto first = int((_height / 2) * index / _results.size()) * 2;
+        const auto end = int((_height / 2) * (index + 1) / _results.size()) * 2;
+        _results[index] = first < end ? _task(first, end - first) : 0;
+    }
+
+    void work(size_t index) {
+        auto generation = uint64_t(0);
+        for (;;) {
+            {
+                auto lock = std::unique_lock<std::mutex>(_mutex);
+                _start.wait(lock, [&] { return _stopping || generation != _generation; });
+                if (_stopping) return;
+                generation = _generation;
+            }
+            execute(index);
+            {
+                const auto lock = std::lock_guard<std::mutex>(_mutex);
+                if (--_remaining == 0) _done.notify_one();
+            }
+        }
+    }
+
+    std::vector<std::thread> _workers;
+    std::vector<int> _results;
+    std::mutex _mutex;
+    std::condition_variable _start, _done;
+    std::function<int(int, int)> _task;
+    size_t _remaining = 0;
+    uint64_t _generation = 0;
+    int _height = 0;
+    bool _stopping = false, _initialized = false;
+
+};
+
+} // namespace tgcalls
+#endif
