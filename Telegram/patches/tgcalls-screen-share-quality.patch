+- (void)publishStats {
+    const auto now = rtc::TimeMicros();
+    const auto seconds = double(now - _windowStart) / 1000000.;
+    if (seconds < 1.) return;
+    stats.captureFps = _captured / seconds;
+    stats.changedFps = _changed / seconds;
+    stats.deliveredFps = _delivered / seconds;
+    stats.deliverMs = _delivered ? _deliveryTotal / _delivered : 0.;
+    stats.loopMs = stats.deliverMs;
+    stats.intervalMs = _delivered ? _intervalTotal / _delivered : 0.;
+    stats.schedulerDelayMs = _delivered ? _lateTotal / _delivered : 0.;
+    _captured = _changed = _delivered = 0;
+    _deliveryTotal = _intervalTotal = _lateTotal = 0.;
