+// Read and written only on the capture scheduler, including on macOS's main
+// queue. The UI receives a value snapshot and never touches these counters.
+class CaptureDiagnostics {
+public:
+    explicit CaptureDiagnostics(int fps) { _totals.requestedFps = fps; }
+    ScreenCaptureStats totals;
+    int64_t captureStartedUs = 0;
+    double captureUs = 0, scaleUs = 0, convertUs = 0, deliverUs = 0;
+    double loopUs = 0, maxLoopUs = 0, intervalUs = 0, schedulerDelayUs = 0;
+    uint64_t attempts = 0, converted = 0, loops = 0, intervals = 0, scheduled = 0;
+    uint64_t scaleSamples = 0, convertSamples = 0, deliverSamples = 0;
+    ScreenCaptureStats snapshot() {
+        const auto now = rtc::TimeMicros();
+        const auto elapsed = now - _windowStartedUs;
+        if (elapsed < 1000000) return _last;
+        auto result = totals;
+        result.available = true;
+        result.requestedFps = _totals.requestedFps;
+        result.captureFps = double(totals.capturedFrames - _totals.capturedFrames) * 1000000 / elapsed;
+        result.changedFps = double((totals.capturedFrames - _totals.capturedFrames)
+            - (totals.unchangedFrames - _totals.unchangedFrames)) * 1000000 / elapsed;
+        result.convertedFps = double(converted) * 1000000 / elapsed;
+        result.deliveredFps = double(totals.deliveredFrames - _totals.deliveredFrames) * 1000000 / elapsed;
+        result.captureMs = attempts ? captureUs / attempts / 1000 : 0;
+        result.scaleMs = scaleSamples ? scaleUs / scaleSamples / 1000 : 0;
+        result.convertMs = convertSamples ? convertUs / convertSamples / 1000 : 0;
+        result.deliverMs = deliverSamples ? deliverUs / deliverSamples / 1000 : 0;
+        result.loopMs = loops ? loopUs / loops / 1000 : 0;
+        result.maxLoopMs = maxLoopUs / 1000;
+        result.intervalMs = intervals ? intervalUs / intervals / 1000 : 0;
+        result.schedulerDelayMs = scheduled ? schedulerDelayUs / scheduled / 1000 : 0;
+        _totals = totals; _totals.requestedFps = result.requestedFps;
+        _last = result; _windowStartedUs = now;
+        captureUs = scaleUs = convertUs = deliverUs = loopUs = maxLoopUs = intervalUs = schedulerDelayUs = 0;
+        attempts = converted = loops = intervals = scheduled = 0;
+        scaleSamples = convertSamples = deliverSamples = 0;
+        return result;
+    }
+private:
+    ScreenCaptureStats _totals, _last;
+    int64_t _windowStartedUs = rtc::TimeMicros();
+};
