+#ifndef TGCALLS_DESKTOP_VIDEO_FRAME_ADAPTER_H_
+#define TGCALLS_DESKTOP_VIDEO_FRAME_ADAPTER_H_
+
+#include "media/base/video_broadcaster.h"
+#include "common_video/framerate_controller.h"
+#include <algorithm>
+#include <functional>
+#include <limits>
+#include <mutex>
+
+namespace tgcalls {
+
+// Apply the encoder's temporal restrictions without changing the resolution
+// selected by the user. Capture also receives this limit to avoid converting
+// frames that will immediately be discarded here.
+class DesktopVideoFrameAdapter final : public rtc::VideoBroadcaster {
+public:
+    void setSelectedFps(int fps) {
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            _selectedFps = std::max(1, fps);
+        }
+        updateLimit();
+    }
+    void setCaptureFpsUpdated(std::function<void(int)> callback) {
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            _captureFpsUpdated = std::move(callback);
+        }
+        notifyCapture();
+    }
+    void AddOrUpdateSink(rtc::VideoSinkInterface<webrtc::VideoFrame> *sink,
+            const rtc::VideoSinkWants &wants) override {
+        rtc::VideoBroadcaster::AddOrUpdateSink(sink, wants);
+        updateLimit();
+    }
+    void RemoveSink(rtc::VideoSinkInterface<webrtc::VideoFrame> *sink) override {
+        rtc::VideoBroadcaster::RemoveSink(sink);
+        updateLimit();
+    }
+    void OnFrame(const webrtc::VideoFrame &frame) override {
+        bool discard;
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            discard = _framerate.ShouldDropFrame(frame.timestamp_us() * 1000);
+        }
+        if (discard) rtc::VideoBroadcaster::OnDiscardedFrame();
+        else rtc::VideoBroadcaster::OnFrame(frame);
+    }
+private:
+    void updateLimit() {
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            const auto fps = std::max(0, std::min(_selectedFps, wants().max_framerate_fps));
+            if (fps == _effectiveFps) return;
+            _effectiveFps = fps;
+            _framerate.Reset();
+            _framerate.SetMaxFramerate(fps);
+        }
+        notifyCapture();
+    }
+    void notifyCapture() {
+        // Encoder and worker threads can update wants concurrently. Serialize
+        // notifications and read the newest value so an older notification
+        // cannot leave the capture scheduler running at a stale limit.
+        std::lock_guard<std::mutex> notificationLock(_notificationMutex);
+        std::function<void(int)> notify;
+        int fps;
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            notify = _captureFpsUpdated;
+            fps = _effectiveFps;
+        }
+        // The callback only posts work, owns a weak renderer, and does not
+        // call back into the adapter.
+        if (notify) notify(fps);
+    }
+    std::mutex _mutex, _notificationMutex;
+    int _selectedFps = std::numeric_limits<int>::max();
+    int _effectiveFps = std::numeric_limits<int>::max();
+    webrtc::FramerateController _framerate;
+    std::function<void(int)> _captureFpsUpdated;
+};
