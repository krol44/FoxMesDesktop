+    if (!CGRectMakeWithDictionaryRepresentation((__bridge CFDictionaryRef)metadata[SCStreamFrameInfoContentRect], &rect)) return;
+    const double scale = [metadata[SCStreamFrameInfoScaleFactor] doubleValue];
+    const double contentScale = [metadata[SCStreamFrameInfoContentScale] doubleValue];
+    if (scale <= 0. || contentScale <= 0.) return;
+    tgcalls::DesktopSize size = {int(std::lround(rect.size.width * scale / contentScale)),
+                                int(std::lround(rect.size.height * scale / contentScale))};
+    if (size.width <= 0 || size.height <= 0) return;
+    stats.sourceWidth = size.width;
+    stats.sourceHeight = size.height;
+    const auto wanted = tgcalls::MacScreenCaptureSize(size, data.aspectSize);
+    if (_updatingConfiguration || (wanted.width == _configuredSize.width && wanted.height == _configuredSize.height)) return;
+    _updatingConfiguration = true;
+    const auto generation = _generation;
+    _configuration.width = wanted.width;
+    _configuration.height = wanted.height;
+    const double destinationScale = std::min({1., double(wanted.width) / size.width, double(wanted.height) / size.height});
+    _configuration.destinationRect = CGRectMake(0, 0, size.width * destinationScale, size.height * destinationScale);
+    [_stream updateConfiguration:_configuration completionHandler:^(NSError *error) {
+        dispatch_async(self->queue, ^{
+            if (!self->_running || generation != self->_generation) return;
+            self->_updatingConfiguration = false;
+            if (error) { [self fail:error]; return; }
+            self->_configuredSize = wanted;
+        });
+    }];
+}
+- (void)stream:(SCStream *)stream didOutputSampleBuffer:(CMSampleBufferRef)sample ofType:(SCStreamOutputType)type {
+    if (!_running || stream != _stream || type != SCStreamOutputTypeScreen || !CMSampleBufferIsValid(sample)) return;
+    NSArray *attachments = (__bridge NSArray *)CMSampleBufferGetSampleAttachmentsArray(sample, false);
+    NSDictionary *metadata = attachments.firstObject;
+    if (!metadata[SCStreamFrameInfoStatus]) return;
+    const auto status = SCFrameStatus([metadata[SCStreamFrameInfoStatus] integerValue]);
+    if (status == SCFrameStatusIdle) { ++stats.unchangedFrames; return; }
+    if (status == SCFrameStatusBlank || status == SCFrameStatusSuspended || status == SCFrameStatusStopped) {
+        _latest = nullptr;
+        [self setPaused:true];
+        return;
+    }
+    if (status != SCFrameStatusComplete) return;
+    auto buffer = tgcalls::MacScreenFrame(sample);
+    if (!buffer) { ++stats.captureErrors; return; }
+    [self setPaused:false];
+    [self updateSourceSize:metadata];
+    _latest = std::move(buffer);
+    ++_captured;
+    ++stats.capturedFrames;
+    NSArray *dirty = metadata[SCStreamFrameInfoDirtyRects];
+    if (!dirty || dirty.count || _serial == 0
+        || stats.width != _latest->width() || stats.height != _latest->height()) {
+        ++_serial;
+        ++_changed;
+    } else ++stats.unchangedFrames;
+    stats.available = true;
+    stats.width = _latest->width();
+    stats.height = _latest->height();
+}
+- (void)stream:(SCStream *)stream didStopWithError:(NSError *)error {
+    // Delegate callbacks are not documented to use the sample queue.
+    dispatch_async(queue, ^{
+        if (self->_running && stream == self->_stream) [self fail:error];
+    });
+}
+@end
+
+namespace tgcalls {
+struct MacScreenCapture::State {
+    FoxMesNativeScreenCapture *capture;
+};
+MacScreenCapture::MacScreenCapture(DesktopCaptureSource source, DesktopCaptureSourceData data)
+: _state(std::make_unique<State>()) {
+    if (@available(macOS 12.3, *)) {
+        _state->capture = [[FoxMesNativeScreenCapture alloc] initWithSource:std::move(source) data:data];
+    }
+}
+MacScreenCapture::~MacScreenCapture() {
+    if (@available(macOS 12.3, *)) {
+        auto capture = _state->capture;
+        dispatch_async(capture->queue, ^{
+            [capture end];
+            capture->output.reset();
+            capture->secondaryOutput.reset();
+            capture->fatalError = {};
+            capture->onPause = {};
+        });
+    }
+}
+void MacScreenCapture::start() {
+    if (@available(macOS 12.3, *)) {
+        auto capture = _state->capture;
+        dispatch_async(capture->queue, ^{ [capture begin]; });
+    }
+}
+void MacScreenCapture::stop() {
+    if (@available(macOS 12.3, *)) {
+        auto capture = _state->capture;
+        dispatch_async(capture->queue, ^{
+            [capture end];
+        });
+    }
+}
+void MacScreenCapture::setOutput(std::shared_ptr<rtc::VideoSinkInterface<webrtc::VideoFrame>> sink) {
+    if (@available(macOS 12.3, *)) {
+        auto capture = _state->capture;
+        dispatch_async(capture->queue, ^{ capture->output = sink; });
+    }
+}
+void MacScreenCapture::setSecondaryOutput(std::shared_ptr<rtc::VideoSinkInterface<webrtc::VideoFrame>> sink) {
+    if (@available(macOS 12.3, *)) {
+        auto capture = _state->capture;
+        dispatch_async(capture->queue, ^{ capture->secondaryOutput = sink; });
+    }
+}
+void MacScreenCapture::setOnFatalError(std::function<void()> callback) {
+    if (@available(macOS 12.3, *)) {
+        auto capture = _state->capture;
+        dispatch_async(capture->queue, ^{ capture->fatalError = callback; });
+    }
+}
+void MacScreenCapture::setOnPause(std::function<void(bool)> callback) {
+    if (@available(macOS 12.3, *)) {
+        auto capture = _state->capture;
+        dispatch_async(capture->queue, ^{ capture->onPause = callback; });
+    }
+}
+void MacScreenCapture::getStats(std::function<void(ScreenCaptureStats)> completion) {
+    if (@available(macOS 12.3, *)) {
+        auto capture = _state->capture;
+        dispatch_async(capture->queue, ^{ [capture publishStats]; completion(capture->stats); });
+    } else completion({});
+}
