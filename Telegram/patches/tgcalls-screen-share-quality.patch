+// Hardware drivers may ignore a requested profile. Never send such output
+// under incompatible negotiated SDP: request software fallback instead.
+bool CompatibleSps(const uint8_t *payload, size_t size,
+        const webrtc::CodecParameterMap &parameters) {
+    if (size < 4 || (payload[0] & 31) != 7) return false;
+    const auto requested = webrtc::ParseSdpForH264ProfileLevelId(parameters);
+    static constexpr char hex[] = "0123456789abcdef";
+    char id[7]{};
+    for (int i = 0; i != 3; ++i) {
+        id[i * 2] = hex[payload[i + 1] >> 4];
+        id[i * 2 + 1] = hex[payload[i + 1] & 15];
+    }
+    const auto actual = webrtc::ParseH264ProfileLevelId(id);
+    if (!actual || !requested) return false;
+    // As in upstream OpenH264, constrained baseline is valid when negotiating
+    // Main/High: those decoder profiles are supersets of constrained baseline.
+    return actual->profile == requested->profile
+        || actual->profile == webrtc::H264Profile::kProfileConstrainedBaseline;
+}
+
+struct Backend {
+    const char *name;
+    std::string device;
+};
+
+std::vector<Backend> HardwareBackends() {
+    std::vector<Backend> result;
+#if defined(_WIN32)
+    result.push_back({"h264_nvenc", {}});
+    result.push_back({"h264_mf", {}});
+#elif defined(__linux__)
+    result.push_back({"h264_nvenc", {}});
+    // Try every DRM render node: renderD128 may be a display GPU without a
+    // usable encoder, while another Intel/AMD device can encode this stream.
+    if (auto *directory = opendir("/dev/dri")) {
+        std::vector<std::string> devices;
+        while (auto *entry = readdir(directory)) {
+            const std::string name = entry->d_name;
+            if (name.compare(0, 7, "renderD") == 0) devices.push_back("/dev/dri/" + name);
+        }
+        closedir(directory);
+        std::sort(devices.begin(), devices.end());
+        for (auto &device : devices) result.push_back({"h264_vaapi", std::move(device)});
+    }
+#endif
+    result.erase(std::remove_if(result.begin(), result.end(), [](const Backend &b) {
+        return !avcodec_find_encoder_by_name(b.name);
+    }), result.end());
+    return result;
+}
+
+class HardwareH264Encoder final : public webrtc::VideoEncoder {
+public:
+    explicit HardwareH264Encoder(webrtc::SdpVideoFormat format)
+        : _format(std::move(format)) {}
+    ~HardwareH264Encoder() override { Release(); }
+
+    int InitEncode(const webrtc::VideoCodec *codec, const Settings &) override {
+        Release();
+        if (!codec || codec->codecType != webrtc::kVideoCodecH264
+                || !codec->width || !codec->height || !codec->maxFramerate
+                || (codec->width & 1) || (codec->height & 1)) {
+            return WEBRTC_VIDEO_CODEC_ERR_PARAMETER;
+        }
+        if (codec->numberOfSimulcastStreams > 1) {
+            return WEBRTC_VIDEO_CODEC_ERR_SIMULCAST_PARAMETERS_NOT_SUPPORTED;
+        }
+        const auto profile = webrtc::ParseSdpForH264ProfileLevelId(_format.parameters);
+        if (!profile || profile->profile == webrtc::H264Profile::kProfilePredictiveHigh444) {
+            return WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
+        }
+        _codec = *codec;
+        _fps = codec->maxFramerate;
+        _bitrate = std::max<int64_t>(10000, int64_t(codec->startBitrate) * 1000);
+        if (_codec.mode == webrtc::VideoCodecMode::kScreensharing) _bitrate = ClampScreenSharingBitrate(_bitrate);
+        _paused = false;
+        for (const auto &backend : HardwareBackends()) {
+            _backend = backend;
+            if (Open()) {
+                RTC_LOG(LS_INFO) << "Screen/video hardware encoder: " << _backend.name
+                    << " " << _backend.device;
+                return WEBRTC_VIDEO_CODEC_OK;
+            }
+            Close();
+        }
+        RTC_LOG(LS_INFO) << "No usable hardware H264 device; using WebRTC software fallback";
+        return WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
+    }
+
+    int32_t RegisterEncodeCompleteCallback(webrtc::EncodedImageCallback *callback) override {
+        _callback = callback;
+        return WEBRTC_VIDEO_CODEC_OK;
+    }
+    int32_t Release() override {
+        Close();
+        _pending.clear();
+        _forceKey = true;
+        _failed = false;
+        _nextPts = 0;
+        return WEBRTC_VIDEO_CODEC_OK;
+    }
+
+    int32_t Encode(const webrtc::VideoFrame &frame,
+            const std::vector<webrtc::VideoFrameType> *types) override {
+        if (_failed) return WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
+        if (!_context || !_callback) return WEBRTC_VIDEO_CODEC_UNINITIALIZED;
+        if (_paused) return WEBRTC_VIDEO_CODEC_OK;
+        if (frame.width() != _codec.width || frame.height() != _codec.height) {
+            return Fail("unexpected resolution");
+        }
+        const auto now = rtc::TimeMillis();
+        if (!_pending.empty() && (now - _pending.front().submitted > 500 || _pending.size() >= 8)) {
+            return Fail("hardware output stalled");
+        }
+        // NVENC reads live AVCodecContext rates. MF/VAAPI in FFmpeg 6.1 do
+        // not: reopen only for significant changes, not every BWE sample.
+        if (NeedsReopen(now)) {
+            Close();
+            for (size_t i = 0; i != _pending.size(); ++i) {
+                _callback->OnDroppedFrame(webrtc::EncodedImageCallback::DropReason::kDroppedByEncoder);
+            }
+            _pending.clear();
+            if (!Open()) return Fail("rate reconfiguration failed");
+            _forceKey = true;
+        }
+        const auto buffer = frame.video_frame_buffer()->ToI420();
+        if (!buffer || av_frame_make_writable(_software) < 0) return Fail("input allocation failed");
+        if (libyuv::I420ToNV12(buffer->DataY(), buffer->StrideY(),
+                buffer->DataU(), buffer->StrideU(), buffer->DataV(), buffer->StrideV(),
+                _software->data[0], _software->linesize[0],
+                _software->data[1], _software->linesize[1], frame.width(), frame.height()) != 0) {
+            return Fail("NV12 conversion failed");
+        }
+        bool key = _forceKey;
+        if (types) for (auto type : *types) key |= type == webrtc::VideoFrameType::kVideoFrameKey;
+        _software->pts = _nextPts;
+        _nextPts += std::max<int64_t>(1, std::llround(90000. / _fps));
+        _software->pict_type = key ? AV_PICTURE_TYPE_I : AV_PICTURE_TYPE_NONE;
+        AVFrame *input = _software;
+        if (_hardware) {
+            av_frame_unref(_hardware);
+            if (av_hwframe_get_buffer(_frames, _hardware, 0) < 0
+                    || av_hwframe_transfer_data(_hardware, _software, 0) < 0
+                    || av_frame_copy_props(_hardware, _software) < 0) {
+                return Fail("GPU upload failed");
+            }
+            input = _hardware;
+        }
+        int result = avcodec_send_frame(_context, input);
+        if (result == AVERROR(EAGAIN)) {
+            if (!Drain()) return Fail("output failed");
+            result = avcodec_send_frame(_context, input);
+        }
+        if (result < 0) return Fail("hardware rejected frame");
+        _pending.push_back({_software->pts, frame.timestamp(), frame.timestamp_us() / 1000,
+            frame.ntp_time_ms(), now, frame.rotation(), frame.color_space()});
+        _forceKey = false;
+        if (!Drain()) return Fail("invalid hardware output");
+        return WEBRTC_VIDEO_CODEC_OK;
+    }
+
+    void SetRates(const RateControlParameters &rates) override {
+        _paused = !rates.bitrate.get_sum_bps();
+        if (_paused || rates.framerate_fps <= 0) return;
+        _bitrate = rates.bitrate.get_sum_bps();
+        if (_codec.mode == webrtc::VideoCodecMode::kScreensharing) _bitrate = ClampScreenSharingBitrate(_bitrate);
+        _fps = std::min<double>(_codec.maxFramerate, rates.framerate_fps);
+        if (_context && std::string(_backend.name) == "h264_nvenc") {
+            _context->bit_rate = _bitrate;
+            _context->rc_max_rate = _bitrate;
+            _context->rc_buffer_size = std::max<int64_t>(10000, _bitrate / 4);
+            _context->framerate = av_d2q(_fps, 1000);
+        }
+    }
+
+    EncoderInfo GetEncoderInfo() const override {
+        EncoderInfo info;
+        info.implementation_name = std::string("FFmpeg/") + (_context ? _backend.name : "hardware H264");
+        info.is_hardware_accelerated = _context != nullptr;
+        info.supports_simulcast = false;
+        info.supports_native_handle = false;
+        info.has_trusted_rate_controller = false;
+        info.requested_resolution_alignment = 2;
+        info.scaling_settings = ScalingSettings(24, 37);
+        return info;
+    }
+
+private:
+    struct Pending {
+        int64_t pts;
+        uint32_t rtp;
+        int64_t capture;
+        int64_t ntp;
+        int64_t submitted;
+        webrtc::VideoRotation rotation;
+        absl::optional<webrtc::ColorSpace> color;
+    };
+
+    bool Open() {
+        const auto *codec = avcodec_find_encoder_by_name(_backend.name);
+        if (!codec || !(_context = avcodec_alloc_context3(codec))) return false;
+        _context->width = _codec.width;
+        _context->height = _codec.height;
+        _context->time_base = {1, 90000};
+        _context->framerate = av_d2q(_fps, 1000);
+        _context->pix_fmt = AV_PIX_FMT_NV12;
+        _context->bit_rate = _bitrate;
+        _context->rc_max_rate = _bitrate;
+        _context->rc_buffer_size = std::max<int64_t>(10000, _bitrate / 4);
+        _context->gop_size = std::max(1, int(_fps * 2));
+        _context->max_b_frames = 0;
+        _context->profile = AV_PROFILE_H264_CONSTRAINED_BASELINE;
+        _context->flags |= AV_CODEC_FLAG_LOW_DELAY;
+        AVDictionary *options = nullptr;
+        const std::string name = _backend.name;
+        if (name == "h264_nvenc") {
+            av_dict_set(&options, "profile", "baseline", 0);
+            av_dict_set(&options, "preset", "p1", 0);
+            av_dict_set(&options, "tune", "ull", 0);
+            av_dict_set(&options, "rc", "cbr", 0);
+            av_dict_set(&options, "zerolatency", "1", 0);
+            // zerolatency disables reordering; FFmpeg's separate output queue
+            // still defaults to two queued frames, which misleads WebRTC CPU
+            // adaptation as FPS falls. Return output as soon as it is ready.
+            av_dict_set(&options, "delay", "0", 0);
+            av_dict_set(&options, "rc-lookahead", "0", 0);
+            av_dict_set(&options, "forced-idr", "1", 0);
+        } else if (name == "h264_mf") {
+            av_dict_set(&options, "hw_encoding", "1", 0);
+            av_dict_set(&options, "rate_control", "cbr", 0);
+            av_dict_set(&options, "scenario", _codec.mode == webrtc::VideoCodecMode::kScreensharing
+                ? "display_remoting" : "video_conference", 0);
+        } else if (name == "h264_vaapi") {
+            av_dict_set(&options, "rc_mode", "CBR", 0);
+            if (av_hwdevice_ctx_create(&_device, AV_HWDEVICE_TYPE_VAAPI,
+                    _backend.device.c_str(), nullptr, 0) < 0) {
+                av_dict_free(&options);
+                return false;
+            }
+            _frames = av_hwframe_ctx_alloc(_device);
+            if (!_frames) { av_dict_free(&options); return false; }
+            auto *frames = reinterpret_cast<AVHWFramesContext *>(_frames->data);
+            frames->format = AV_PIX_FMT_VAAPI;
+            frames->sw_format = AV_PIX_FMT_NV12;
+            frames->width = _codec.width;
+            frames->height = _codec.height;
+            frames->initial_pool_size = 4;
+            if (av_hwframe_ctx_init(_frames) < 0) { av_dict_free(&options); return false; }
+            _context->pix_fmt = AV_PIX_FMT_VAAPI;
+            _context->hw_frames_ctx = av_buffer_ref(_frames);
+            _hardware = av_frame_alloc();
+            if (!_hardware || !_context->hw_frames_ctx) { av_dict_free(&options); return false; }
+        }
+        const auto result = avcodec_open2(_context, codec, &options);
+        const bool unusedOptions = av_dict_count(options) != 0;
+        av_dict_free(&options);
+        if (result < 0 || unusedOptions) return false;
+        _software = av_frame_alloc();
+        _packet = av_packet_alloc();
+        if (!_software || !_packet) return false;
+        _software->format = AV_PIX_FMT_NV12;
+        _software->width = _codec.width;
+        _software->height = _codec.height;
+        if (av_frame_get_buffer(_software, 32) < 0) return false;
+        _headers.clear();
+        _lengthBytes = 4;
+        if (!H264ParameterSets(_context->extradata, _context->extradata_size, _lengthBytes, _headers)) return false;
+        _openedBitrate = _bitrate;
+        _openedFps = _fps;
+        _lastOpen = rtc::TimeMillis();
+        _parser = std::make_unique<webrtc::H264BitstreamParser>();
+        return true;
+    }
+
+    void Close() {
+        av_packet_free(&_packet);
+        av_frame_free(&_hardware);
+        av_frame_free(&_software);
+        avcodec_free_context(&_context);
+        av_buffer_unref(&_frames);
+        av_buffer_unref(&_device);
+    }
+    bool NeedsReopen(int64_t now) const {
+        if (std::string(_backend.name) == "h264_nvenc") {
+            // FFmpeg 6.1 reconfigures bitrate dynamically, but not frame rate.
+            return std::abs(_fps - _openedFps) > _openedFps * .1 && now - _lastOpen >= 1000;
+        }
+        const bool changed = std::abs(_bitrate - _openedBitrate) > _openedBitrate * .15
+            || std::abs(_fps - _openedFps) > _openedFps * .1;
+        return changed && (now - _lastOpen >= 1000 || _bitrate < _openedBitrate * .5);
+    }
+    int Fail(const char *reason) {
+        RTC_LOG(LS_WARNING) << _backend.name << ": " << reason << "; software fallback";
+        _failed = true;
+        return WEBRTC_VIDEO_CODEC_FALLBACK_SOFTWARE;
