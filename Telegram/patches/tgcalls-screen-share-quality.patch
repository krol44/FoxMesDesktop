+    return self;
+}
+- (void)setPaused:(bool)value {
+    if (_paused == value) return;
+    _paused = value;
+    if (onPause) onPause(value);
+}
+- (void)fail:(NSError *)error {
+    RTC_LOG(LS_ERROR) << "ScreenCaptureKit: " << (error ? error.localizedDescription.UTF8String : "selected source unavailable");
+    ++stats.captureErrors;
+    [self end];
+    if (fatalError) fatalError();
+}
+- (void)begin {
+    if (_running) return;
+    _running = true;
+    const auto generation = ++_generation;
+    stats = {};
+    stats.nativeCapture = true;
+    stats.requestedFps = int(std::lround(data.fps));
