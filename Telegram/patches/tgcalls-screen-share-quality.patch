+- (void)end {
+    _running = false;
+    ++_generation;
+    _updatingConfiguration = false;
+    if (_timer) { dispatch_source_cancel(_timer); _timer = nil; }
+    _latest = nullptr;
+    if (_stream) {
+        [_stream removeStreamOutput:self type:SCStreamOutputTypeScreen error:nil];
+        [_stream stopCaptureWithCompletionHandler:^(NSError *error) {}];
+        _stream = nil;
+    }
+    _configuration = nil;
+}
+- (void)startTimer {
+    if (_timer || !_running) return;
+    _deadline = rtc::TimeMicros();
+    _timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, queue);
+    __weak FoxMesNativeScreenCapture *weakSelf = self;
+    dispatch_source_set_event_handler(_timer, ^{ [weakSelf deliver]; });
+    dispatch_source_set_timer(_timer, DISPATCH_TIME_NOW, uint64_t(std::llround(1000000000. / data.fps)), 250000);
+    dispatch_resume(_timer);
+}
+- (void)deliver {
+    if (!_running) return;
+    const auto now = rtc::TimeMicros();
+    const auto lateness = std::max<int64_t>(0, now - _deadline);
+    _deadline += (lateness / _period + 1) * _period;
+    if (!_latest || (!output && !secondaryOutput)) return;
