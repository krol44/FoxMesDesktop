+#ifndef TGCALLS_GROUP_SCREEN_SHARING_PARAMS_H
+#define TGCALLS_GROUP_SCREEN_SHARING_PARAMS_H
+
+#include "tgcalls/ScreenSharing.h"
+#include "api/rtp_parameters.h"
+
+namespace tgcalls {
+
+// Legacy VP9 collapses negotiated simulcast SSRCs to one SVC send stream.
+// WebRTC configures that stream from encoding zero, not from the last layer.
+// Applying H264's thumbnail limits to encoding zero caps the entire VP9 stream
+// at half resolution and 100 kbps. Keep the full profile on the first encoding;
+// VP9's internal spatial layers remain controlled by its bitrate allocator.
+inline void ConfigureVp9ScreenSharing(webrtc::RtpParameters &params,
+        const ScreenSharingProfile &profile, int constraint) {
+    for (auto i = size_t(0); i < params.encodings.size(); ++i) {
+        auto &encoding = params.encodings[i];
+        encoding.active = i == 0 && constraint > 0;
+        encoding.scale_resolution_down_by = 1.0;
+        encoding.min_bitrate_bps = i == 0 ? 300000 : 0;
+        encoding.max_bitrate_bps = profile.maxBitrate;
+    }
+}
+
+} // namespace tgcalls
+#endif
