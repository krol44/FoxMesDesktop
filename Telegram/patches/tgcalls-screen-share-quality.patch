+#ifndef TGCALLS_SCREEN_ENCODING_SPEED_H
+#define TGCALLS_SCREEN_ENCODING_SPEED_H
+
+#include <cstdint>
+#include <optional>
+
+namespace tgcalls {
+
+class ScreenEncodingSpeed {
+public:
+    std::optional<bool> update(int64_t now, int requestedFps, int inputFps,
+            int bitrate, int qp, bool enabled) {
+        if (qp < 0 || inputFps <= 0 || requestedFps <= 5) {
+            _condition = 0;
+            _since = -1;
+            return std::nullopt;
+        }
+        const auto needSpeed = !enabled && inputFps < requestedFps * 0.85
+            && bitrate >= 1000000 && qp <= 39;
+        const auto needQuality = enabled && (qp > 39
+            || (inputFps >= requestedFps * 0.95 && qp <= 28));
+        if (!needSpeed && !needQuality) {
+            _condition = 0;
+            _since = -1;
+            return std::nullopt;
+        }
+        const auto condition = needSpeed ? 1 : qp > 39 ? 2 : 3;
+        if (condition != _condition) {
+            _condition = condition;
+            _since = now;
+        }
+        if (_since < 0) _since = now;
+        const auto delay = needSpeed ? 2000 : qp > 39 ? 5000 : 30000;
+        if (now - _since < delay || now < _cooldownUntil) return std::nullopt;
+        _since = -1;
+        _cooldownUntil = now + (needSpeed ? 10000 : 30000);
+        return needSpeed;
+    }
+
+private:
+    int _condition = 0;
+    int64_t _since = -1;
+    int64_t _cooldownUntil = 0;
+
+};
+
+} // namespace tgcalls
+#endif
