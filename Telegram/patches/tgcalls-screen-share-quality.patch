+#ifndef TGCALLS_SCREEN_BANDWIDTH_PROBE_POLICY_H_
+#define TGCALLS_SCREEN_BANDWIDTH_PROBE_POLICY_H_
+
+#include <algorithm>
+#include <cstdint>
+
+namespace tgcalls {
+
+enum class ScreenBandwidthProbeStatus {
+    Inactive, Monitoring, WaitingForFeedback, WaitingForNetwork,
+    Cooldown, Probing, WaitingForResult, RemoteLimit
+};
+inline const char *ScreenBandwidthProbeStatusText(ScreenBandwidthProbeStatus status) {
+    switch (status) {
+    case ScreenBandwidthProbeStatus::Inactive: return "inactive";
+    case ScreenBandwidthProbeStatus::Monitoring: return "monitoring";
+    case ScreenBandwidthProbeStatus::WaitingForFeedback: return "waiting for transport feedback";
+    case ScreenBandwidthProbeStatus::WaitingForNetwork: return "waiting for network to settle";
+    case ScreenBandwidthProbeStatus::Cooldown: return "probe cooldown";
+    case ScreenBandwidthProbeStatus::Probing: return "probing bandwidth";
+    case ScreenBandwidthProbeStatus::WaitingForResult: return "waiting for probe result";
+    case ScreenBandwidthProbeStatus::RemoteLimit: return "remote/profile bitrate limit";
+    }
+    return "inactive";
+}
+
+// Runs on the congestion controller's queue. Probes test capacity; this policy
+// never raises the encoder target or the congestion controller's estimate.
+class ScreenBandwidthProbePolicy {
+public:
+    ScreenBandwidthProbeStatus status() const { return _status; }
+    void reset() { *this = ScreenBandwidthProbePolicy(); }
+
+    int update(int64_t nowMs, int screenLimit, int bandwidth, int64_t rttMs,
+            double loss, int64_t queueMs, int64_t feedbackAgeMs,
+            bool networkAvailable, int probeLimit, bool nativeProbe = false) {
+        if (_screenLimit != screenLimit) {
+            reset();
+            _screenLimit = screenLimit;
+        }
+        if (screenLimit <= 0) return 0;
+        if (!networkAvailable || feedbackAgeMs < 0 || feedbackAgeMs > 3000 || bandwidth <= 0) {
+            _goodSince = -1;
+            _status = ScreenBandwidthProbeStatus::WaitingForFeedback;
+            return 0;
+        }
+        const auto healthyNetwork = rttMs >= 0 && rttMs <= std::max<int64_t>(250, 2 * _healthyRtt)
+            && loss <= 0.02 && queueMs >= 0 && queueMs <= 50;
+        if (_baseline > 0 && bandwidth < int64_t(_baseline) * 55 / 100) {
+            if (_dipSince < 0) _dipSince = nowMs;
+        }
+        if (_dipSince < 0 || bandwidth >= int64_t(_baseline) * 75 / 100) {
+            _dipSince = -1;
+            _goodSince = -1;
+            _retryMs = 5000;
+            _status = ScreenBandwidthProbeStatus::Monitoring;
+            if (healthyNetwork && (_baselineAt < 0 || nowMs - _baselineAt >= 1000)) {
+                _baseline = _baseline == 0 ? bandwidth : int((15LL * _baseline + bandwidth) / 16);
+                _healthyRtt = rttMs;
+                _baselineAt = nowMs;
+            }
+            return 0;
+        }
+        if (!healthyNetwork) {
+            _goodSince = -1;
+            _status = ScreenBandwidthProbeStatus::WaitingForNetwork;
+            return 0;
+        }
+        if (_goodSince < 0) _goodSince = nowMs;
+        if (nativeProbe) {
+            _lastProbeAt = nowMs;
+            _pending = false;
+        }
+        if (_pending && nowMs - _lastProbeAt >= 5000) {
+            _retryMs = bandwidth > int64_t(_probeBandwidth) * 110 / 100
+                ? 5000 : std::min(30000, _retryMs * 2);
+            _pending = false;
+        }
+        if (nowMs - _dipSince < 5000 || nowMs - _goodSince < 2000
+            || (_lastProbeAt >= 0 && nowMs - _lastProbeAt < _retryMs)) {
+            _status = _pending ? ScreenBandwidthProbeStatus::WaitingForResult : ScreenBandwidthProbeStatus::Cooldown;
+            return 0;
+        }
+        const auto rate = std::min<int64_t>({int64_t(2) * bandwidth, int64_t(_baseline),
+            int64_t(screenLimit), int64_t(probeLimit)});
+        if (rate < int64_t(bandwidth) * 120 / 100) {
+            _status = ScreenBandwidthProbeStatus::RemoteLimit;
+            return 0;
+        }
+        _lastProbeAt = nowMs;
+        _probeBandwidth = bandwidth;
+        _pending = true;
+        _status = ScreenBandwidthProbeStatus::Probing;
+        return int(rate);
+    }
+
+private:
+    ScreenBandwidthProbeStatus _status = ScreenBandwidthProbeStatus::Inactive;
+    int _screenLimit = 0, _baseline = 0, _retryMs = 5000, _probeBandwidth = 0;
+    int64_t _healthyRtt = 0, _baselineAt = -1, _dipSince = -1, _goodSince = -1, _lastProbeAt = -1;
+    bool _pending = false;
+};
+} // namespace tgcalls
