+    void setScreenAudioEnabled(bool enabled) {
+        _mutex.Lock();
+        _screenAudioEnabled = enabled;
+        if (!enabled) {
+            _samples.clear();
+        }
+        _mutex.Unlock();
+    }
+
+    void addSamples(const std::vector<uint8_t> &bytes) {
+        if (bytes.size() % sizeof(int16_t)) {
+            return;
+        }
+        _mutex.Lock();
+        if (_screenAudioEnabled) {
+            const auto count = bytes.size() / sizeof(int16_t);
+            for (auto i = size_t(0); i != count; ++i) {
+                int16_t sample = 0;
+                std::memcpy(&sample, bytes.data() + i * sizeof(sample), sizeof(sample));
+                _samples.push_back(sample);
+            }
+            constexpr auto kMaxSamples = 48000 / 2;
+            if (_samples.size() > kMaxSamples) {
+                _samples.erase(_samples.begin(), _samples.begin() + (_samples.size() - kMaxSamples));
+            }
+        }
+        _mutex.Unlock();
+    }
+
+private:
+    void Initialize(int sample_rate_hz, int num_channels) override {
+        _sampleRate = sample_rate_hz;
+    }
+
+    void Process(webrtc::AudioBuffer *buffer) override {
+        if (!buffer) {
+            return;
+        }
+        _mutex.Lock();
+        const auto frames = buffer->num_frames();
+        const auto channels = buffer->num_channels();
+        // Audio processing normally runs at 48 kHz. At other rates,
+        // take the matching number of 48 kHz screen samples per frame.
+        const auto step = 48000.0 / std::max(_sampleRate, 1);
+        for (auto i = 0; i != frames; ++i) {
+            const auto offset = size_t(i * step);
+            const auto screen = (_screenAudioEnabled && offset < _samples.size())
+                ? float(_samples[offset]) : 0.f;
+            for (auto channel = 0; channel != channels; ++channel) {
+                auto &sample = buffer->channels()[channel][i];
+                const auto microphone = _microphoneMuted ? 0.f : sample;
+                sample = std::clamp(microphone + screen, -32768.f, 32767.f);
+            }
+        }
+        if (_screenAudioEnabled) {
+            const auto consumed = std::min(_samples.size(), size_t(frames * step));
+            _samples.erase(_samples.begin(), _samples.begin() + consumed);
+        }
+        _mutex.Unlock();
+    }
+
+    std::string ToString() const override { return "ScreenAudioMixer"; }
+    void SetRuntimeSetting(webrtc::AudioProcessing::RuntimeSetting) override {}
+
+    webrtc::Mutex _mutex;
+    std::vector<int16_t> _samples;
+    bool _microphoneMuted = false;
+    bool _screenAudioEnabled = false;
+    int _sampleRate = 48000;
+};
+
+} // namespace tgcalls
