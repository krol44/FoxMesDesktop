+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace tgcalls {
+
+inline bool H264AnnexB(const uint8_t *data, size_t size) {
+    return size >= 3 && !data[0] && !data[1]
+        && (data[2] == 1 || (size >= 4 && !data[2] && data[3] == 1));
+}
+
+// FFmpeg backends may return either Annex B or length-prefixed AVC. RTP's
+// H264 packetizer expects Annex B. Reject truncated lengths, never guess.
+inline bool H264ToAnnexB(const uint8_t *data, size_t size, int lengthBytes,
+        std::vector<uint8_t> &output) {
+    if (!data || !size) return false;
+    if (H264AnnexB(data, size)) {
+        output.assign(data, data + size);
+        return true;
+    }
+    if (lengthBytes < 1 || lengthBytes > 4) return false;
+    output.clear();
+    size_t pos = 0;
+    while (pos < size) {
+        if (size - pos < size_t(lengthBytes)) return false;
+        size_t length = 0;
+        for (int i = 0; i != lengthBytes; ++i) length = (length << 8) | data[pos++];
+        if (!length || length > size - pos) return false;
+        output.insert(output.end(), {0, 0, 0, 1});
+        output.insert(output.end(), data + pos, data + pos + length);
+        pos += length;
+    }
+    return !output.empty();
+}
+
+inline bool H264ParameterSets(const uint8_t *data, size_t size,
+        int &lengthBytes, std::vector<uint8_t> &output) {
+    if (!data || !size) return true;
+    if (H264AnnexB(data, size)) {
+        output.assign(data, data + size);
+        return true;
+    }
+    if (size < 7 || data[0] != 1) return false;
+    lengthBytes = (data[4] & 3) + 1;
+    size_t pos = 6;
+    const int spsCount = data[5] & 31;
+    output.clear();
+    for (int group = 0, count = spsCount; group != 2; ++group) {
+        for (int i = 0; i != count; ++i) {
+            if (size - pos < 2) return false;
+            const size_t length = (size_t(data[pos]) << 8) | data[pos + 1];
+            pos += 2;
+            if (!length || length > size - pos) return false;
+            output.insert(output.end(), {0, 0, 0, 1});
+            output.insert(output.end(), data + pos, data + pos + length);
+            pos += length;
+        }
+        if (!group) {
+            if (pos == size) return false;
+            count = data[pos++];
+        }
+    }
+    return true;
+}
+} // namespace tgcalls
