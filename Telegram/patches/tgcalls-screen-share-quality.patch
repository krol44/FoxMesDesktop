+#ifndef TGCALLS_SCREEN_SHARING_PERFORMANCE_H
+#define TGCALLS_SCREEN_SHARING_PERFORMANCE_H
+
+#include "ScreenSharing.h"
+
+namespace tgcalls {
+
+class ScreenSharingPerformance {
+public:
+    void reset(int fps, int64_t now) {
+        *this = ScreenSharingPerformance();
+        _maximumFps = _fps = std::max(1, fps);
+        _notBefore = now + 12000;
+    }
+
+    int fps() const { return _fps; }
+
+    std::string state() const {
+        return "performance ceiling " + std::to_string(_fps) + " FPS"
+            + (_probing ? "; probing recovery" : "");
+    }
+
+    // CPU restrictions survive a source reconfiguration. Probe them only after
+    // a warm-up and several healthy network samples. Hardware encode usage has
+    // different thresholds from software (150/200 versus 55/85 in WebRTC);
+    // it is not the process CPU percentage. Project usage to the candidate FPS
+    // before trying it, then back off if that probe causes another restriction.
+    bool update(int64_t now, const ScreenSharingStats &stats) {
+        if (now < _notBefore || stats.encoderInputFps <= 0 || stats.fps <= 0
+            || stats.encodeUsagePercent <= 0) {
+            _busySamples = _spareSamples = _probeHealthySamples = 0;
+            return false;
+        }
+        if (stats.limitation == "bandwidth" || stats.availableBitrate < 1000000
+            || stats.targetBitrate <= 0
+            || stats.availableBitrate < stats.targetBitrate * 0.9
+            || stats.lossPercent > 2 || stats.pacerDelayMs > 100) {
+            _busySamples = _spareSamples = _probeHealthySamples = 0;
+            return false;
+        }
+        const auto hardware = stats.powerEfficientKnown && stats.powerEfficient;
+        const auto budget = hardware ? 180.0 : 75.0;
+        const auto projectedUsage = stats.encodeUsagePercent
+            * double(_fps) / stats.encoderInputFps;
+        const auto poorQuality = (stats.codec == "H264" || stats.codec == "H265")
+            && stats.averageQp >= 39;
+        const auto restricted = stats.cpuLimited
+            && stats.encoderInputFps < _fps * 0.85;
+        const auto overloaded = restricted || projectedUsage > budget;
+        if (_probing && !overloaded) {
+            if (++_probeHealthySamples >= 20) {
+                _probing = false;
+                _retryMs = 40000;
+            }
+        }
+        if (overloaded) {
+            _probeHealthySamples = 0;
+            _spareSamples = 0;
+            if (++_busySamples < 8) return false;
+            _busySamples = 0;
+            if (!_probing && restricted && projectedUsage < budget && !poorQuality) {
+                _probing = true;
+                _probeHealthySamples = 0;
+                _notBefore = now + 12000;
+                return true;
+            }
+            const auto lower = nextLower(_fps);
+            if (lower == _fps) return false;
+            if (_probing) _retryMs = std::min<int64_t>(160000, _retryMs * 2);
+            _probing = false;
+            _fps = lower;
+            _notBefore = now + _retryMs;
+            return true;
+        }
+        _busySamples = 0;
+        const auto higher = std::min(_maximumFps, nextHigher(_fps));
+        const auto spare = higher > _fps && !stats.cpuLimited && !poorQuality
+            && stats.encoderInputFps >= _fps * 0.9
+            && stats.encodeUsagePercent * double(higher) / stats.encoderInputFps < budget;
+        if (!spare) {
+            _spareSamples = 0;
+            return false;
+        }
+        if (++_spareSamples < 20) return false;
+        _spareSamples = 0;
+        _fps = higher;
+        _probing = true;
+        _probeHealthySamples = 0;
+        _notBefore = now + 12000;
+        return true;
+    }
+
+    void suspend(int64_t now) {
+        _notBefore = std::max(_notBefore, now + 12000);
+        _busySamples = _spareSamples = _probeHealthySamples = 0;
+    }
+
+private:
+    static int nextLower(int fps) {
+        for (const auto candidate : {50, 40, 30, 24, 20, 15, 10, 5}) {
+            if (candidate < fps) return candidate;
+        }
+        return fps;
+    }
+
+    static int nextHigher(int fps) {
+        for (const auto candidate : {5, 10, 15, 20, 24, 30, 40, 50, 60}) {
+            if (candidate > fps) return candidate;
+        }
+        return fps;
+    }
+
+    int _maximumFps = 15, _fps = 15;
+    int _busySamples = 0, _spareSamples = 0, _probeHealthySamples = 0;
+    int64_t _notBefore = 0, _retryMs = 40000;
+    bool _probing = false;
+
+};
+
+} // namespace tgcalls
+#endif
