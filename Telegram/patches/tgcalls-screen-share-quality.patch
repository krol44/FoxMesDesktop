+            SCStreamConfiguration *config = [[SCStreamConfiguration alloc] init];
+            config.width = self->_configuredSize.width;
+            config.height = self->_configuredSize.height;
+            config.pixelFormat = kCVPixelFormatType_420YpCbCr8BiPlanarFullRange;
+            config.minimumFrameInterval = CMTimeMake(1, self->stats.requestedFps);
+            config.queueDepth = 8;
+            config.showsCursor = self->data.captureMouse;
+            config.scalesToFit = NO;
+            const double contentScale = std::min({1., double(config.width) / size.width, double(config.height) / size.height});
+            config.destinationRect = CGRectMake(0, 0, size.width * contentScale, size.height * contentScale);
