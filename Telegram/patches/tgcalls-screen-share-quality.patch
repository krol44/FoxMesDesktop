+#ifndef TGCALLS_SCREEN_SHARING_MEDIA_H
+#define TGCALLS_SCREEN_SHARING_MEDIA_H
+#include "ScreenSharing.h"
+#include "media/base/media_channel.h"
+#include "rtc_base/logging.h"
+#include "rtc_base/time_utils.h"
+
+namespace tgcalls {
+class ScreenSharingStatsAccumulator {
+public:
+    void update(ScreenSharingStats &stats, int64_t bytes, uint64_t retransmitted, uint64_t qpFrames, uint64_t qpSum, bool qpAvailable, uint32_t qpSsrc) {
+        const auto now = rtc::TimeMillis();
+        const auto elapsed = now - _lastTime;
+        if (_lastTime && elapsed > 0 && bytes >= _bytes && retransmitted >= _retransmitted) {
+            stats.rtpBitrate = int((bytes - _bytes) * 8000 / elapsed);
+            stats.retransmissionBitrate = int((retransmitted - _retransmitted) * 8000 / elapsed);
+        }
+        if (qpAvailable && _qpAvailable && qpSsrc == _qpSsrc && qpFrames > _qpFrames && qpSum >= _qpSum) {
+            stats.averageQp = double(qpSum - _qpSum) / (qpFrames - _qpFrames);
+        }
+        _lastTime = now; _bytes = bytes; _retransmitted = retransmitted;
+        _qpFrames = qpFrames; _qpSum = qpSum; _qpAvailable = qpAvailable; _qpSsrc = qpSsrc;
+    }
+private:
+    int64_t _lastTime = 0, _bytes = 0;
+    uint64_t _retransmitted = 0, _qpFrames = 0, _qpSum = 0;
+    uint32_t _qpSsrc = 0;
+    bool _qpAvailable = false;
+};
+inline ScreenSharingStats ReadOutgoingVideoStats(cricket::VideoMediaSendChannelInterface *channel, ScreenSharingStatsAccumulator &accumulator) {
+    ScreenSharingStats result;
+    cricket::VideoMediaSendInfo info;
+    if (!channel->GetStats(&info)) return result;
+    int64_t bytes = 0;
+    uint64_t retransmitted = 0, qpFrames = 0, qpSum = 0;
+    uint32_t qpSsrc = 0;
+    bool qpAvailable = false;
+    for (const auto &sender : info.senders) {
+        bytes += sender.payload_bytes_sent + sender.header_and_padding_bytes_sent;
+        retransmitted += sender.retransmitted_bytes_sent;
+        // This is an aggregate stream rate copied into every simulcast layer.
+        result.bitrate = std::max(result.bitrate, sender.nominal_bitrate);
+        result.targetBitrate = std::max(result.targetBitrate, int(sender.target_bitrate.value_or(0)));
+        result.encodeMs = std::max(result.encodeMs, sender.avg_encode_ms);
+        result.encodeUsagePercent = std::max(result.encodeUsagePercent, sender.encode_usage_percent);
+        result.encodedFrames += sender.frames_encoded;
+        result.keyFrames += sender.key_frames_encoded;
+        result.nacks += sender.nacks_received;
+        result.plis += sender.plis_received;
+        result.lossPercent = std::max(result.lossPercent, double(sender.fraction_lost) * 100.0);
+        result.cpuLimited |= sender.quality_limitation_reason == webrtc::QualityLimitationReason::kCpu;
+        if (sender.quality_limitation_reason == webrtc::QualityLimitationReason::kCpu) result.limitation = "CPU";
+        else if (!result.cpuLimited && sender.quality_limitation_reason == webrtc::QualityLimitationReason::kBandwidth) result.limitation = "bandwidth";
+        else if (result.limitation == "none" && sender.quality_limitation_reason == webrtc::QualityLimitationReason::kOther) result.limitation = "other";
+        if (sender.encoder_implementation_name) result.encoder = *sender.encoder_implementation_name;
+        if (sender.power_efficient_encoder) { result.powerEfficientKnown = true; result.powerEfficient = *sender.power_efficient_encoder; }
+        // Stopped simulcast layers retain old dimensions. Only count live layers.
+        if (sender.framerate_sent <= 0) continue;
+        if (sender.send_frame_width * sender.send_frame_height >= result.width * result.height) {
+            result.width = sender.send_frame_width;
+            result.height = sender.send_frame_height;
+            result.fps = sender.framerate_sent;
+            result.inputFps = int(sender.framerate_input);
+            result.encoderInputFps = sender.framerate_input;
+            qpFrames = sender.frames_encoded;
+            qpSum = sender.qp_sum.value_or(0);
+            qpAvailable = sender.qp_sum.has_value();
+            qpSsrc = sender.ssrc();
+            if (sender.codec_payload_type) {
+                const auto codec = info.send_codecs.find(*sender.codec_payload_type);
+                if (codec != info.send_codecs.end()) result.codec = codec->second.name;
+            }
+        }
+    }
+    accumulator.update(result, bytes, retransmitted, qpFrames, qpSum, qpAvailable, qpSsrc);
+    return result;
+}
+inline void RecoverVideoAdaptation(cricket::VideoMediaSendChannelInterface *channel, uint32_t ssrc) {
+    // FoxMes uses the factory's default selector. In this WebRTC version,
+    // reapplying it recreates the send stream while retaining its source,
+    // negotiated parameters and Call's suspended RTP/payload state. This
+    // actually resets the encoder and adaptation; BALANCED is mapped back to
+    // MAINTAIN_RESOLUTION for screens and therefore cannot clear restrictions.
+    channel->SetEncoderSelector(ssrc, nullptr);
+    channel->GenerateSendKeyFrame(ssrc, {});
+    RTC_LOG(LS_INFO) << "FoxMes: recreated screen send stream after bandwidth recovery";
+}
+} // namespace tgcalls
+#endif
