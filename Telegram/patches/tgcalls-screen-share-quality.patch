+#ifndef TGCALLS_H265_BITRATE_RECOVERY_H
+#define TGCALLS_H265_BITRATE_RECOVERY_H
+
+#include <algorithm>
+#include <cstdint>
+#include "tgcalls/ScreenSharing.h"
+
+namespace tgcalls {
+
+// VideoToolbox can retain near-maximum QP after a bitrate dip even when its
+// allocation has recovered. A keyframe alone does not reset that rate control.
+class H265BitrateRecovery {
+public:
+    bool update(int64_t now, uint32_t target, uint32_t media, int qp) {
+        const auto stalled = ScreenEncoderBitrateUndershoot(target, media, qp >= 48);
+        if (!stalled) {
+            _stalledSince = -1;
+            _windowTarget = 0;
+            return false;
+        }
+        // Watch the current allocation, including startup at a reduced rate.
+        // Large changes restart the evidence window; an old peak does not
+        // prevent recovery at a perfectly usable 9.8 Mbps allocation.
+        if (_stalledSince < 0 || int64_t(target) * 5 < int64_t(_windowTarget) * 4
+            || int64_t(target) * 5 > int64_t(_windowTarget) * 6) {
+            _stalledSince = now;
+            _windowTarget = target;
+        }
+        if (now - _stalledSince < 3000 || now < _retryAfter) {
+            return false;
+        }
+        _stalledSince = -1;
+        _retryAfter = now + 30000;
+        return true;
+    }
+
+private:
+    uint32_t _windowTarget = 0;
+    int64_t _stalledSince = -1;
+    int64_t _retryAfter = 0;
+};
+
+} // namespace tgcalls
+#endif
