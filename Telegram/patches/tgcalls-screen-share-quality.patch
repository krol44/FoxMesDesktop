+#ifndef TGCALLS_GROUP_SCREEN_SHARING_PARAMS_H
+#define TGCALLS_GROUP_SCREEN_SHARING_PARAMS_H
+
+#include "tgcalls/ScreenSharing.h"
+#include "api/rtp_parameters.h"
+
+namespace tgcalls {
+
+// Explicit single-layer VP9 avoids WebRTC's legacy screen SVC ladder,
+// whose first spatial layer is hard-capped at 5 FPS / 250 kbps.
+inline void ConfigureVp9ScreenSharing(webrtc::RtpParameters &params,
+        const ScreenSharingProfile &profile, int constraint) {
+    for (auto i = size_t(0); i < params.encodings.size(); ++i) {
+        auto &encoding = params.encodings[i];
+        encoding.active = i == 0 && constraint > 0;
+        encoding.scale_resolution_down_by = 1.0;
+        encoding.scalability_mode = "L1T1";
+        encoding.min_bitrate_bps = i == 0 ? 300000 : 0;
+        encoding.max_bitrate_bps = profile.maxBitrate;
+    }
+}
+
+// Keep negotiated SSRCs, but encode thumbnail layers at their actual display
+// size. Half of a 5K desktop is not a useful 100 kbps thumbnail.
+inline void ConfigureH264ScreenSharing(webrtc::RtpParameters &params,
+        const ScreenSharingProfile &profile, int constraint, int fps) {
+    for (auto i = size_t(0); i < params.encodings.size(); ++i) {
+        auto &encoding = params.encodings[i];
+        const auto full = i + 1 == params.encodings.size();
+        encoding.scale_resolution_down_by.reset();
+        encoding.requested_resolution.reset();
+        if (full) {
+            if (profile.width > 0 && profile.height > 0) {
+                encoding.requested_resolution = webrtc::Resolution{profile.width, profile.height};
+            }
+            encoding.min_bitrate_bps = params.encodings.size() > 1 ? 200000 : 0;
+            encoding.max_bitrate_bps = profile.maxBitrate - (params.encodings.size() > 2 ? 150000 : params.encodings.size() > 1 ? 100000 : 0);
+            encoding.max_framerate = fps;
+            encoding.active = params.encodings.size() == 1 ? constraint > 0 : constraint >= 720;
+        } else {
+            const auto small = params.encodings.size() > 2 && i == 0;
+            encoding.requested_resolution = small ? webrtc::Resolution{320,180} : webrtc::Resolution{640,360};
+            encoding.min_bitrate_bps = small ? 25000 : 50000;
+            encoding.max_bitrate_bps = small ? 50000 : 100000;
+            encoding.max_framerate = std::min(fps, 5);
+            // With two SSRCs this is also the lowest (180p viewer) layer.
+            encoding.active = constraint >= (i == 0 ? 180 : 360);
+        }
+    }
+}
