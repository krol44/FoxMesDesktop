+            const auto *payload = bytes.data() + nalu.payload_start_offset;
+            if ((payload[0] & 31) == 7) {
+                if (!CompatibleSps(payload, nalu.payload_size, _format.parameters)) return false;
+                sps = true;
+            } else if ((payload[0] & 31) == 8) {
