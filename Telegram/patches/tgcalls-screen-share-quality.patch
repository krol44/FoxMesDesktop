+@implementation FoxMesNativeScreenCapture
+- (instancetype)initWithSource:(tgcalls::DesktopCaptureSource)value data:(tgcalls::DesktopCaptureSourceData)options {
+    if ((self = [super init])) {
+        queue = dispatch_queue_create("ing.foxtail.FoxMes.screen-capture", DISPATCH_QUEUE_SERIAL);
+        sourceId = value.uniqueId();
+        sourceIsWindow = value.isWindow();
+        data = options;
+        data.fps = std::clamp(data.fps, 1., 60.);
+        _period = int64_t(std::llround(1000000. / data.fps));
