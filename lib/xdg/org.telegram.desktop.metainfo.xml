<?xml version="1.0" encoding="utf-8"?>
<component type="desktop">
    <id>ru.fxl.foxMes</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0</project_license>
    <name>FoxMes</name>
    <summary>Desktop client for FoxMes</summary>
    <description>
        <p>FoxMes Desktop is the native desktop client for the FoxMes messaging service.</p>
        <p>It supports personal conversations, Saved Messages, message history, media sharing and live updates through the FoxMes backend.</p>
        <p>This application is based on Telegram Desktop and is distributed as an independent FoxMes client.</p>
    </description>
    <categories>
        <category>Network</category>
        <category>InstantMessaging</category>
    </categories>
    <developer id="ru.fxl"><name>Foxtail</name></developer>
    <url type="homepage">https://fxl.ru</url>
    <url type="bugtracker">https://github.com/krol44/FoxMesDesktop/issues</url>
    <url type="vcs-browser">https://github.com/krol44/FoxMesDesktop</url>
    <branding>
        <color type="primary" scheme_preference="light">#edf0f2</color>
        <color type="primary" scheme_preference="dark">#2d363f</color>
    </branding>
    <keywords>
        <keyword>foxmes</keyword>
        <keyword>messaging</keyword>
        <keyword>messenger</keyword>
        <keyword>chat</keyword>
        <keyword>sms</keyword>
        <keyword>im</keyword>
    </keywords>
    <requires>
        <!-- windowMinHeight from FoxMes/SourceFiles/window/window.style -->
        <display_length compare="ge">480</display_length>
        <internet>always</internet>
        <!-- on-screen keyboards are too big for current minimal display height -->
        <control>keyboard</control>
    </requires>
    <supports>
        <control>pointing</control>
        <control>touch</control>
    </supports>
    <content_rating type="oars-1.1">
